@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked out";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClientSphere CRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card shadow-sm text-center border-0 rounded-3">
                    <div class="card-body p-5">
                        <div class="text-danger mb-4">
                            <i class="bi bi-shield-lock-fill" style="font-size: 3rem;" aria-hidden="true"></i>
                        </div>
                        <h1 class="h4 mb-3 fw-bold text-dark">Account Locked Out</h1>
                        <p class="text-muted mb-4">
                            Your account has been temporarily locked due to multiple failed login attempts. Please try again in 15 minutes.
                        </p>
                        <a href="~/" class="btn btn-primary w-100">Return to Home</a>
                    </div>
                </div>

                <div class="mt-4 text-center text-muted small">
                    <i class="bi bi-shield-check text-danger me-1"></i>
                    Need help? Review account policies in our <a href="/Home/SecurityPolicy" target="_blank" class="fw-semibold text-decoration-none">Security Policy</a>.
                </div>
            </div>
        </div>
    </div>

</body>
</html>
