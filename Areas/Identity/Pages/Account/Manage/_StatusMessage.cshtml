@model string

@if (!string.IsNullOrEmpty(Model))
{
    var statusMessageClass = Model.StartsWith("Error") ? "danger" : "success";
    var statusIcon = Model.StartsWith("Error") ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    <div class="alert alert-@statusMessageClass alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi @statusIcon me-2"></i>
        @Model
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
