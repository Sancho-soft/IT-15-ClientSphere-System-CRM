@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery Codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<h3 class="mb-4">@ViewData["Title"]</h3>

<div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-exclamation-octagon-fill me-3" style="font-size: 1.5rem;"></i>
    <div>
        <strong>Save these codes in a secure location!</strong>
        <p class="mb-0 small">If you lose your device and don't have the recovery codes you will lose access to your account. These codes will only be shown once.</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row g-2 justify-content-center">
            @for (var i = 0; i < Model.RecoveryCodes.Length; i++)
            {
                <div class="col-6 col-md-4">
                    <div class="bg-light rounded p-2 text-center">
                        <code class="fs-6 user-select-all">@Model.RecoveryCodes[i]</code>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-outline-primary" id="copy-codes-btn" onclick="copyRecoveryCodes()">
        <i class="bi bi-clipboard me-1"></i>Copy All Codes
    </button>
    <a asp-page="./TwoFactorAuthentication" class="btn btn-primary">
        <i class="bi bi-arrow-left me-1"></i>Back to 2FA Settings
    </a>
</div>

@section Scripts {
    <script>
        function copyRecoveryCodes() {
            const codes = [@Html.Raw(string.Join(",", Model.RecoveryCodes.Select(c => $"\"{c}\"")))];
            const text = codes.join('\n');
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copy-codes-btn');
                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Copied!';
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-success');
                setTimeout(() => {
                    btn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy All Codes';
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-outline-primary');
                }, 2000);
            });
        }
    </script>
}
