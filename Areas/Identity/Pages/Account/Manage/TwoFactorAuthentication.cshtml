@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-Factor Authentication (MFA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="gsap-fade-in">
    @if (Model.Is2faEnabled)
    {
        <!-- MFA Active Header -->
        <div class="d-flex align-items-center mb-5 gap-3 border-bottom pb-4">
            <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px; flex-shrink: 0;">
                <i class="bi bi-shield-fill-check fs-2"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-1">MFA is Active</h4>
                <p class="text-muted mb-0 small">Your account is fortified with an extra layer of verification during sign-in.</p>
            </div>
        </div>

        <!-- MFA Configuration Cards -->
        <h5 class="fw-bold mb-3"><i class="bi bi-list-check me-2 text-primary"></i>Security Status</h5>
        <div class="row g-4 mb-5">
            <!-- Recovery Codes -->
            <div class="col-md-4">
                <div class="card border border-light-subtle shadow-sm h-100 hover-lift">
                    <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                        <div>
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-key-fill fs-4"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Recovery Codes</h6>
                            <p class="text-muted small mb-0">Emergency access keys if you lose your primary device</p>
                        </div>
                        <div class="mt-3">
                            @if (Model.RecoveryCodesLeft == 0)
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-3 py-2 w-100">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>0 Codes Remaining!
                                </span>
                            }
                            else if (Model.RecoveryCodesLeft == 1)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle rounded-pill px-3 py-2 w-100">
                                    <i class="bi bi-exclamation-circle-fill me-1"></i>1 Code Remaining!
                                </span>
                            }
                            else if (Model.RecoveryCodesLeft <= 3)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle rounded-pill px-3 py-2 w-100">
                                    @Model.RecoveryCodesLeft Codes Left
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-2 w-100">
                                    @Model.RecoveryCodesLeft Codes Active
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Authenticator App -->
            <div class="col-md-4">
                <div class="card border border-light-subtle shadow-sm h-100 hover-lift">
                    <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                        <div>
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-phone-vibrate-fill fs-4"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Authenticator App</h6>
                            <p class="text-muted small mb-0">Google Authenticator, Microsoft Authenticator, or similar</p>
                        </div>
                        <div class="mt-3">
                            @if (Model.HasAuthenticator)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-2 w-100">
                                    <i class="bi bi-check-circle-fill me-1"></i>Configured
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle rounded-pill px-3 py-2 w-100">
                                    Not Configured
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Remember Browser -->
            <div class="col-md-4">
                <div class="card border border-light-subtle shadow-sm h-100 hover-lift">
                    <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                        <div>
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-laptop-fill fs-4"></i>
                            </div>
                            <h6 class="fw-bold mb-1">This Browser</h6>
                            <p class="text-muted small mb-0">Skip verification steps on this trusted device</p>
                        </div>
                        <div class="mt-3">
                            @if (Model.IsMachineRemembered)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-2 w-100">
                                    <i class="bi bi-check-circle-fill me-1"></i>Remembered
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle rounded-pill px-3 py-2 w-100">
                                    Not Remembered
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Actions -->
        <div class="card border-0 bg-body-tertiary p-4 rounded-3 mb-5">
            <h6 class="fw-bold mb-3"><i class="bi bi-sliders me-2 text-secondary"></i>Manage Authentication Settings</h6>
            <div class="row g-3">
                <div class="col-md-6 col-lg-4">
                    <a asp-page="./Disable2fa" class="btn btn-outline-danger w-100 py-2.5 fw-semibold shadow-sm">
                        <i class="bi bi-shield-lock-fill me-2"></i>Disable 2FA
                    </a>
                </div>
                <div class="col-md-6 col-lg-4">
                    <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-warning w-100 py-2.5 fw-semibold shadow-sm text-dark">
                        <i class="bi bi-arrow-repeat me-2"></i>Reset Recovery Codes
                    </a>
                </div>
                @if (Model.IsMachineRemembered)
                {
                    <div class="col-md-6 col-lg-4">
                        <form method="post" asp-page-handler="ForgetBrowser" class="w-100">
                            <button type="submit" class="btn btn-outline-secondary w-100 py-2.5 fw-semibold shadow-sm">
                                <i class="bi bi-x-circle-fill me-2"></i>Forget This Browser
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Authenticator App Configuration options -->
        <h5 class="fw-bold mb-3"><i class="bi bi-phone me-2 text-primary"></i>Authenticator Configuration</h5>
        <div class="card border border-light-subtle shadow-sm p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h6 class="fw-bold mb-1">Time-based One-Time Password (TOTP)</h6>
                    <p class="text-muted small mb-0">Use authenticator apps on your mobile device to retrieve 6-digit dynamic codes.</p>
                </div>
                <div class="d-flex gap-2">
                    @if (!Model.HasAuthenticator)
                    {
                        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary fw-semibold px-4 py-2">
                            <i class="bi bi-shield-plus me-2"></i>Setup Authenticator
                        </a>
                    }
                    else
                    {
                        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-outline-primary fw-semibold px-3 py-2">
                            <i class="bi bi-pencil-square me-2"></i>Configure App
                        </a>
                        <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-danger fw-semibold px-3 py-2">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Reset Key
                        </a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- MFA Inactive Header -->
        <div class="d-flex align-items-center mb-5 gap-3 border-bottom pb-4">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px; flex-shrink: 0; animation: pulse-red 2s infinite;">
                <i class="bi bi-shield-fill-exclamation fs-2"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-1">MFA is Inactive</h4>
                <p class="text-muted mb-0 small">Protect your account from credentials leaks and unauthorized access by enabling Multi-Factor Authentication.</p>
            </div>
        </div>

        <!-- Security Warning Box -->
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start mb-5 p-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-warning me-3 fs-3"></i>
            <div>
                <h6 class="alert-heading fw-bold mb-1 text-warning-emphasis">Elevated Security Risk</h6>
                <p class="mb-0 small text-muted">Without MFA, your password is the only protection between cybercriminals and your ClientSphere database access. Enabling Multi-Factor Verification dramatically reduces account takeover vulnerabilities.</p>
            </div>
        </div>

        <!-- Security Options -->
        <h5 class="fw-bold mb-4"><i class="bi bi-shield-lock-fill me-2 text-primary"></i>Choose Verification Method</h5>
        <div class="row g-4">
            <!-- Email Verification -->
            <div class="col-lg-6">
                <div class="card border border-light-subtle shadow-sm h-100 hover-lift">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-envelope-open-fill fs-4"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Email Verification</h6>
                            <p class="text-muted small mb-0">Receive a secure 6-digit one-time code to your registered email address upon each sign-in attempt.</p>
                        </div>
                        <div class="mt-4">
                            <form method="post" asp-page-handler="EnableEmailMfa">
                                <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold shadow-sm">
                                    <i class="bi bi-shield-plus me-2"></i>Enable Email MFA
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Authenticator Application -->
            <div class="col-lg-6">
                <div class="card border border-light-subtle shadow-sm h-100 hover-lift">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-phone-vibrate-fill fs-4"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Authenticator App</h6>
                            <p class="text-muted small mb-0">Sync your account with Google Authenticator, Microsoft Authenticator, or Bitwarden for offline code generation.</p>
                        </div>
                        <div class="mt-4">
                            <a asp-page="./EnableAuthenticator" class="btn btn-outline-primary w-100 py-2.5 fw-semibold shadow-sm">
                                <i class="bi bi-phone me-2"></i>Setup Authenticator App
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
