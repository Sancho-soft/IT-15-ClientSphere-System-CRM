@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-Factor Authentication (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<h3 class="mb-4">@ViewData["Title"]</h3>

@if (Model.Is2faEnabled)
{
    <div class="alert alert-success border-0 shadow-sm d-flex align-items-center" role="alert">
        <i class="bi bi-shield-fill-check me-3" style="font-size: 1.5rem;"></i>
        <div>
            <strong>Two-factor authentication is enabled.</strong>
            <p class="mb-0 small text-muted">Your account is protected with an additional verification step on each login.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-key-fill text-primary mb-2" style="font-size: 2rem;"></i>
                    <h6 class="card-title">Recovery Codes</h6>
                    <p class="card-text small text-muted">
                        @if (Model.RecoveryCodesLeft == 0)
                        {
                            <span class="text-danger fw-bold">No recovery codes left!</span>
                        }
                        else if (Model.RecoveryCodesLeft == 1)
                        {
                            <span class="text-warning fw-bold">1 code remaining</span>
                        }
                        else if (Model.RecoveryCodesLeft <= 3)
                        {
                            <span class="text-warning">@Model.RecoveryCodesLeft codes remaining</span>
                        }
                        else
                        {
                            <span>@Model.RecoveryCodesLeft codes remaining</span>
                        }
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-phone text-primary mb-2" style="font-size: 2rem;"></i>
                    <h6 class="card-title">Authenticator App</h6>
                    <p class="card-text small text-muted">
                        @if (Model.HasAuthenticator)
                        {
                            <span class="text-success">Configured</span>
                        }
                        else
                        {
                            <span>Not configured</span>
                        }
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-laptop text-primary mb-2" style="font-size: 2rem;"></i>
                    <h6 class="card-title">This Browser</h6>
                    <p class="card-text small text-muted">
                        @if (Model.IsMachineRemembered)
                        {
                            <span class="text-success">Remembered</span>
                        }
                        else
                        {
                            <span>Not remembered</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @if (Model.IsMachineRemembered)
        {
            <form method="post" asp-page-handler="ForgetBrowser" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Forget This Browser
                </button>
            </form>
        }
        <a asp-page="./Disable2fa" class="btn btn-outline-danger">
            <i class="bi bi-shield-x me-1"></i>Disable 2FA
        </a>
        <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-primary">
            <i class="bi bi-arrow-repeat me-1"></i>Reset Recovery Codes
        </a>
    </div>

    <hr class="my-4" />

    <h5 class="mb-3">Authenticator App (Optional)</h5>
    <p class="text-muted small mb-3">You can also set up an authenticator app for additional security options.</p>
    <div class="d-flex flex-wrap gap-2">
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-outline-primary">
                <i class="bi bi-phone me-1"></i>Setup Authenticator App
            </a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-outline-primary">
                <i class="bi bi-phone me-1"></i>Configure Authenticator App
            </a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Authenticator App
            </a>
        }
    </div>
}
else
{
    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-3" style="font-size: 1.5rem;"></i>
        <div>
            <strong>Two-factor authentication is not enabled.</strong>
            <p class="mb-0 small">Enable 2FA to add an extra layer of security to your account.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-start">
                <div class="me-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10" style="width: 48px; height: 48px;">
                        <i class="bi bi-envelope-check text-primary" style="font-size: 20px;"></i>
                    </span>
                </div>
                <div class="flex-grow-1">
                    <h5 class="mb-1">Email Verification</h5>
                    <p class="text-muted small mb-3">Receive a 6-digit code via email each time you sign in. This is the recommended option for most users.</p>
                    <form method="post" asp-page-handler="EnableEmailMfa">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-shield-plus me-1"></i>Enable Email 2FA
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex align-items-start">
                <div class="me-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10" style="width: 48px; height: 48px;">
                        <i class="bi bi-phone text-secondary" style="font-size: 20px;"></i>
                    </span>
                </div>
                <div class="flex-grow-1">
                    <h5 class="mb-1">Authenticator App</h5>
                    <p class="text-muted small mb-3">Use an app like Google Authenticator or Microsoft Authenticator for time-based codes.</p>
                    <a asp-page="./EnableAuthenticator" class="btn btn-outline-secondary">
                        <i class="bi bi-phone me-1"></i>Setup Authenticator App
                    </a>
                </div>
            </div>
        </div>
    </div>
}
