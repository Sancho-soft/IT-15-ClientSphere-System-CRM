@inject Microsoft.AspNetCore.Identity.SignInManager<ClientSphere.Models.ApplicationUser> SignInManager
@{
    if (SignInManager.IsSignedIn(User) && User.IsInRole("Customer"))
    {
        Layout = "/Views/Shared/_CustomerLayout.cshtml";
    }
    else if (SignInManager.IsSignedIn(User))
    {
        Layout = "/Views/Shared/_CrmLayout.cshtml";
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="container-fluid py-4">
    <div class="row g-4">
        <!-- Sidebar Navigation for Manage -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4">
                    <h6 class="fw-bold mb-0 text-uppercase text-muted" style="letter-spacing: .05em;"><i class="bi bi-gear-fill me-2"></i>Account Settings</h6>
                </div>
                <div class="card-body p-3">
                    <partial name="_ManageNav" />
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 p-md-5">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
