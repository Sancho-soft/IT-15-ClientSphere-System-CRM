@page
@model LoginWithRecoveryCodeModel

@{
    ViewData["Title"] = "Recovery Code Verification";
}

<div class="container py-5 gsap-slide-up">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10" style="width: 64px; height: 64px;">
                                <i class="bi bi-life-preserver text-warning" style="font-size: 28px;"></i>
                            </span>
                        </div>
                        <h2 class="fw-bold mb-2">Recovery Code</h2>
                        <p class="text-muted">Enter one of your recovery codes to sign in. Each code can only be used once.</p>
                    </div>

                    <form id="recovery-code-form" method="post" class="gsap-stagger-container">
                        <div asp-validation-summary="ModelOnly" class="text-danger gsap-stagger-item" role="alert"></div>
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                        <div class="mb-4 gsap-stagger-item">
                            <label asp-for="Input.RecoveryCode" class="form-label fw-bold">Recovery Code</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key-fill"></i></span>
                                <input asp-for="Input.RecoveryCode" class="form-control border-start-0 ps-0 font-monospace"
                                       autocomplete="off" placeholder="Enter recovery code" autofocus />
                            </div>
                            <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                        </div>

                        <div class="d-grid mb-3 gsap-stagger-item">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold" id="recover-btn">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                            </button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        <small class="text-muted">
                            <a asp-page="./LoginWith2fa" class="text-decoration-none fw-bold">
                                <i class="bi bi-arrow-left me-1"></i>Back to code verification
                            </a>
                        </small>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center text-muted small">
                <i class="bi bi-shield-check text-success me-1"></i>
                Recovery codes are subject to single-use rules. Read our <a asp-controller="Home" asp-action="SecurityPolicy" target="_blank" class="fw-semibold text-decoration-none">Security Policy</a>.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
