@page
@model LoginWithRecoveryCodeModel

@{
    ViewData["Title"] = "Recovery Code Verification";
}

<div class="container py-5 d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5 col-xl-4">
            <div class="card mfa-card border-0 rounded-4 overflow-hidden shadow-lg">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <span class="mfa-icon-badge">
                                <i class="bi bi-life-preserver text-warning"></i>
                            </span>
                        </div>
                        <h2 class="fw-bold mb-2">Recovery Code</h2>
                        <p class="text-muted">Enter one of your recovery codes to sign in. Each code can only be used once.</p>
                    </div>

                    <form id="recovery-code-form" method="post" asp-page="./LoginWithRecoveryCode">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center" role="alert"></div>
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                        <div class="mb-4">
                            <label asp-for="Input.RecoveryCode" class="form-label fw-bold mb-2 text-muted uppercase-tracking">Recovery Code</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="bi bi-key-fill text-muted"></i></span>
                                <input asp-for="Input.RecoveryCode" id="recovery-code-input" class="form-control border-start-0 ps-0 font-monospace rounded-end-3 py-2 fs-5"
                                       autocomplete="off" placeholder="Enter 8-digit recovery code" autofocus />
                            </div>
                            <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold btn-recover py-3 text-dark" id="recover-btn">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                            </button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        <small class="text-muted">
                            <a asp-page="./LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold text-primary">
                                <i class="bi bi-arrow-left me-1"></i>Back to code verification
                            </a>
                        </small>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center text-muted small">
                <i class="bi bi-shield-check text-success me-1"></i>
                Recovery codes are subject to single-use rules. Read our <a asp-controller="Home" asp-action="SecurityPolicy" target="_blank" class="fw-semibold text-decoration-none text-primary">Security Policy</a>.
            </div>
        </div>
    </div>
</div>

<style>
    .mfa-card {
        background: var(--bs-card-bg, #fff);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .mfa-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    }

    .mfa-icon-badge {
        width: 72px;
        height: 72px;
        font-size: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: rgba(255, 193, 7, 0.1);
        color: #ffc107;
    }

    .uppercase-tracking {
        font-size: 0.8rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .btn-recover {
        border-radius: 12px;
        transition: all 0.2s ease;
    }
    
    .btn-recover:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
