@model ClientSphere.ViewModels.UserManagementViewModel
@{
    ViewData["Title"] = "User Management";
    ViewData["HideTopNavTitle"] = true;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<!-- Summary Cards Section -->
<div class="row mb-4">
    <div class="col-md-2">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                 <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-2 me-2">
                    <i class="bi bi-people h5 mb-0"></i>
                </div>
                <div>
                     <div class="text-muted small">Total Users</div>
                     <h3 class="fw-bold mb-0">@Model.TotalUsers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                 <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-2 me-2">
                    <i class="bi bi-shield-lock h5 mb-0"></i>
                </div>
                <div>
                    <div class="text-muted small">Admins</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.AdminCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                 <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-2 me-2">
                    <i class="bi bi-graph-up-arrow h5 mb-0"></i>
                </div>
                <div>
                    <div class="text-muted small">Sales</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.SalesTeamCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm p-3">
             <div class="d-flex align-items-center">
                 <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-2 me-2">
                    <i class="bi bi-headset h5 mb-0"></i>
                </div>
                <div>
                    <div class="text-muted small">Support</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.SupportTeamCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
         <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                 <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-2 me-2">
                    <i class="bi bi-check-circle h5 mb-0"></i>
                </div>
                <div>
                    <div class="text-muted small">Active</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.ActiveUsers</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control bg-light border-start-0 ps-0" placeholder="Search users by name or email..." id="userSearch">
            </div>
            <div>
                 <button class="btn btn-outline-secondary me-2"><i class="bi bi-funnel"></i> All Roles</button>
                 <a asp-action="CreateUser" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Add New User</a>
            </div>
        </div>

        <div class="table-responsive" style="overflow: visible;">
            <table class="table table-hover align-middle mb-0" id="usersTable">
                <thead class="table-light">
                    <tr>
                        <th class="border-0 small fw-bold">USER</th>
                        <th class="border-0 small fw-bold">ROLE</th>
                        <th class="border-0 small fw-bold">STATUS</th>
                        <th class="border-0 small fw-bold">LAST ACTIVE</th>
                        <th class="border-0 small fw-bold text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        var isCurrentUser = User.Identity?.Name == user.Email;
                        var isSuperAdmin = User.IsInRole(ClientSphere.Constants.Roles.SuperAdmin);
                        var canManage = isSuperAdmin || user.Role != ClientSphere.Constants.Roles.SuperAdmin;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                    {
                                        <img src="@user.ProfilePictureUrl" alt="@user.Initials" class="rounded-circle me-3 object-fit-cover" style="width: 40px; height: 40px;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3 bg-secondary bg-opacity-10 text-secondary fw-bold" style="width: 40px; height: 40px; font-size: 0.9rem;">@user.Initials</div>
                                    }
                                    <div>
                                        <div class="fw-bold">@user.FullName</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-secondary bg-opacity-10 text-body rounded-pill px-3 py-2 fw-normal" style="font-size: 0.8rem;">@user.Role</span></td>
                            <td>
                                @if (user.Status == "Active")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-normal" style="font-size: 0.8rem;">Active</span>
                                }
                                else if (user.Status == "Locked Out")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-normal" style="font-size: 0.8rem;">Locked Out</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-normal" style="font-size: 0.8rem;">@user.Status</span>
                                }
                            </td>
                            <td class="text-muted small" style="font-size: 0.85rem;">@user.LastActiveDisplay</td>
                            <td class="text-end">
                                @if (canManage)
                                {
                                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-link text-primary text-decoration-none px-2" title="Edit User"><i class="bi bi-pencil-square"></i></a>
                                    <a asp-action="ResetPassword" asp-route-userId="@user.Id" class="btn btn-sm btn-link text-warning text-decoration-none px-2" title="Reset Password"><i class="bi bi-key"></i></a>
                                    
                                    @if (!isCurrentUser)
                                    {
                                        @if (user.IsLockedOut)
                                        {
                                            <form asp-action="UnlockUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-link text-success text-decoration-none px-2" title="Unlock User"
                                                        data-confirm="true"
                                                        data-confirm-title="Unlock @user.FullName?"
                                                        data-confirm-text="This will lift the temporary account lockout or suspension."
                                                        data-confirm-icon="question"
                                                        data-confirm-ok="Yes, unlock"
                                                        data-confirm-ok-color="#198754">
                                                    <i class="bi bi-unlock"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (user.Status == "Inactive")
                                        {
                                            <form asp-action="ReactivateUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-link text-success text-decoration-none px-2" title="Reactivate User"
                                                        data-confirm="true"
                                                        data-confirm-title="Reactivate @user.FullName?"
                                                        data-confirm-text="This will restore their login access."
                                                        data-confirm-icon="question"
                                                        data-confirm-ok="Yes, reactivate"
                                                        data-confirm-ok-color="#198754">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <!-- Suspend / Deactivate Modal Trigger -->
                                            <button class="btn btn-sm btn-link text-danger text-decoration-none px-2" type="button" data-bs-toggle="modal" data-bs-target="#suspendModal_@user.Id" title="Suspend/Deactivate User">
                                                <i class="bi bi-person-slash"></i>
                                            </button>


                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-shield-lock me-1"></i>Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Summary Cards Section -->


@foreach (var user in Model.Users)
{
    var isCurrentUser = User.Identity?.Name == user.Email;
    var isSuperAdmin = User.IsInRole(ClientSphere.Constants.Roles.SuperAdmin);
    var canManage = isSuperAdmin || user.Role != ClientSphere.Constants.Roles.SuperAdmin;

    if (canManage && !isCurrentUser && user.Status != "Inactive")
    {
        <!-- Suspend Modal for @user.Id -->
        <div class="modal fade" id="suspendModal_@user.Id" tabindex="-1" aria-labelledby="suspendModalLabel_@user.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg border-0">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold" id="suspendModalLabel_@user.Id">Suspend or Deactivate User</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-start">
                        <p class="text-muted mb-4">Choose an action for <strong class="text-body">@user.FullName</strong>. Suspended users are locked out temporarily. Deactivated users are permanently blocked.</p>
                        
                        <div class="d-grid gap-3 mb-2">
                            <form asp-action="SuspendUser" asp-route-id="@user.Id" asp-route-durationDays="1" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-warning w-100 text-start py-2" 
                                        data-confirm="true" 
                                        data-confirm-title="Suspend @user.FullName for 1 Day?" 
                                        data-confirm-text="They will be locked out for 24 hours."
                                        data-confirm-icon="warning"
                                        data-confirm-ok="Yes, suspend"
                                        data-confirm-ok-color="#ffc107">
                                    <i class="bi bi-clock me-3"></i>Suspend for 1 Day
                                </button>
                            </form>

                            <form asp-action="SuspendUser" asp-route-id="@user.Id" asp-route-durationDays="7" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-warning w-100 text-start py-2" 
                                        data-confirm="true" 
                                        data-confirm-title="Suspend @user.FullName for 1 Week?" 
                                        data-confirm-text="They will be locked out for 7 days."
                                        data-confirm-icon="warning"
                                        data-confirm-ok="Yes, suspend"
                                        data-confirm-ok-color="#ffc107">
                                    <i class="bi bi-calendar-event me-3"></i>Suspend for 1 Week
                                </button>
                            </form>
                            
                            <hr class="text-muted my-1" />

                            <form asp-action="DeactivateUser" asp-route-id="@user.Id" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger w-100 text-start py-2 fw-bold" 
                                        data-confirm="true" 
                                        data-confirm-input="password"
                                        data-confirm-title="Deactivate @user.FullName?" 
                                        data-confirm-text="They will be deactivated indefinitely and cannot log in." 
                                        data-confirm-icon="warning" 
                                        data-confirm-ok="Yes, deactivate"
                                        data-confirm-ok-color="#dc3545">
                                    <i class="bi bi-person-x me-3"></i>Deactivate (Permanent)
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<script>
    // Simple client-side search
    document.getElementById('userSearch').addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('#usersTable tbody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });
</script>

