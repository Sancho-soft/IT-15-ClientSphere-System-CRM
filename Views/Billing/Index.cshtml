@model ClientSphere.ViewModels.BillingDashboardViewModel

@{
    ViewData["Title"] = "Billing & Invoices";
    ViewData["HideTopNavTitle"] = true;
    Layout = "~/Views/Shared/_CrmLayout.cshtml";
    ViewData["CurrentPage"] = "Billing";
}

@{
    var isBillingArchived = Context.Request.Query["archived"].ToString().ToLower() == "true";
    var processingInvoices = Model.Invoices.Where(i => i.Status == "Processing").ToList();
    var processingCount = processingInvoices.Count;
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Billing & Invoice Management</h3>
            <p class="text-muted mb-0">Manage invoices, payments, and billing records</p>
        </div>
        <div class="col-md-6 text-md-end">
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Generate Invoice
            </a>
            <button class="btn btn-white border shadow-sm ms-2" onclick="window.print()">
                <i class="bi bi-download me-2"></i>Export
            </button>
        </div>
    </div>

    @* Processing Invoices Alert Banner *@
    @if (processingCount > 0 && !isBillingArchived)
    {
        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4 p-3" role="alert">
            <div class="fs-4 flex-shrink-0">
                <i class="bi bi-bell-fill text-info"></i>
            </div>
            <div class="flex-grow-1">
                <strong>@processingCount invoice@(processingCount > 1 ? "s" : "") awaiting your confirmation!</strong><br>
                <span class="text-muted small">A customer submitted payment via PayMongo. Review below and click <strong>Mark Paid</strong> to confirm.</span>
            </div>
        </div>
    }

    <!-- Status Tabs (Staff/Admin only) -->
    @if (User.IsInRole("Admin") || User.IsInRole("Super Admin") || User.IsInRole("Billing Staff"))
    {
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link @(!isBillingArchived ? "active fw-bold" : "")" href="?archived=false">
                    <i class="bi bi-receipt me-1"></i> Active Invoices
                    @if (processingCount > 0)
                    {
                        <span class="badge bg-danger ms-1">@processingCount</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(isBillingArchived ? "active fw-bold" : "")" href="?archived=true">
                    <i class="bi bi-archive me-1"></i> Archived
                </a>
            </li>
        </ul>
    }

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-3 me-3">
                        <i class="h4 mb-0 fw-bold">&#8369;</i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Revenue</div>
                        <h3 class="fw-bold mb-0 text-dark">&#8369;@Model.TotalRevenue.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-3 me-3">
                        <i class="bi bi-clock-history h4 mb-0"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Pending</div>
                        <h3 class="fw-bold mb-0 text-dark">&#8369;@Model.PendingRevenue.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
             <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-3 me-3">
                        <i class="bi bi-exclamation-circle h4 mb-0"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Overdue</div>
                        <h3 class="fw-bold mb-0 text-dark">&#8369;@Model.OverdueRevenue.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
             <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-3 me-3">
                        <i class="bi bi-receipt h4 mb-0"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Invoices</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalInvoices</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-2">
            <div class="input-group">
                <span class="input-group-text bg-white border-0 ps-3"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-0" placeholder="Search invoices by ID, customer, or customer ID...">
                <button class="btn btn-light border-start rounded-0 px-4" type="button"><i class="bi bi-funnel me-2"></i> All Status</button>
            </div>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-uppercase text-muted small">
                            <th class="ps-4 border-0">Invoice ID</th>
                            <th class="border-0">Customer</th>
                            <th class="border-0">Sale ID</th>
                            <th class="border-0">Amount</th>
                            <th class="border-0">Due Date</th>
                            <th class="border-0">Status</th>
                            <th class="border-0">Payment Method</th>
                            <th class="pe-4 border-0 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model.Invoices)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@invoice.InvoiceId<div class="small fw-normal text-muted">@invoice.IssuedDate.ToString("yyyy-MM-dd")</div></td>
                                <td class="fw-bold">
                                    @invoice.CustomerName
                                    <div class="small fw-normal text-muted">@invoice.CustomerId</div>
                                </td>
                                <td>@invoice.SaleId</td>
                                <td class="fw-bold">
                                    &#8369;@invoice.Amount.ToString("N0")
                                    <div class="small fw-normal text-muted">~ ₱@invoice.AmountInPHP.ToString("N2") (PHP)</div>
                                </td>
                                <td><i class="bi bi-calendar me-1 text-muted"></i> @invoice.DueDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if(invoice.Status == "Paid")
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-3"><i class="bi bi-check-circle me-1 text-muted"></i> Paid</span>
                                    }
                                    else if(invoice.Status == "Unpaid")
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-3"><i class="bi bi-clock me-1 text-muted"></i> Unpaid</span>
                                    }
                                    else if(invoice.Status == "Partial")
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-3"><i class="bi bi-pie-chart me-1 text-muted"></i> Partial</span>
                                    }
                                    else if(invoice.Status == "Overdue")
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-3"><i class="bi bi-exclamation-circle me-1 text-muted"></i> Overdue</span>
                                    }
                                    else if(invoice.Status == "Processing")
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-3"><i class="bi bi-arrow-repeat me-1 text-muted"></i> Processing</span>
                                        @if (!string.IsNullOrEmpty(invoice.PaymentMethod))
                                        {
                                            <div class="small text-muted mt-1">via @invoice.PaymentMethod</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-3">@invoice.Status</span>
                                    }
                                </td>
                                <td>
                                    @if(invoice.PaymentMethod == "Bank Transfer")
                                    {
                                         <span><i class="bi bi-bank me-1 text-muted"></i> Bank Transfer</span>
                                    }
                                    else if(invoice.PaymentMethod == "Credit Card")
                                    {
                                         <span><i class="bi bi-credit-card me-1 text-muted"></i> Credit Card</span>
                                    }
                                    else if(invoice.PaymentMethod != null && invoice.PaymentMethod.StartsWith("PayMongo"))
                                    {
                                        <span><i class="bi bi-wallet2 me-1 text-muted"></i> @invoice.PaymentMethod</span>
                                    }
                                    else if(invoice.PaymentMethod == "Manual")
                                    {
                                        <span><i class="bi bi-person-check me-1 text-muted"></i> Manual</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@invoice.PaymentMethod</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-link text-decoration-none px-0" title="View Details"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@invoice.Id" class="btn btn-sm btn-link text-decoration-none px-0" title="Edit Invoice"><i class="bi bi-pencil-square"></i></a>
                                        <a href="javascript:window.print()" class="btn btn-sm btn-link text-decoration-none px-0" title="Download PDF"><i class="bi bi-download"></i></a>
                                        @if(invoice.Status == "Unpaid" || invoice.Status == "Overdue" || invoice.Status == "Processing" || invoice.Status == "Partial")
                                        {
                                            <form asp-action="MarkAsPaid" asp-route-id="@invoice.Id" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-0 d-flex align-items-center" style="font-size: 0.75rem;" title="Mark Paid Manually">Mark Paid</button>
                                            </form>
                                            @if(invoice.Status != "Processing")
                                            {
                                                <form asp-action="GeneratePaymongoLink" asp-route-id="@invoice.Id" method="post" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 py-0 d-flex align-items-center" style="font-size: 0.75rem;" title="Pay via Paymongo (GCash, PayMaya, Card)"><i class="bi bi-wallet2 me-1"></i> Paymongo</button>
                                                </form>
                                            }
                                        }
                                        <form asp-action="SendInvoiceEmail" asp-route-id="@invoice.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-info rounded-pill px-3 py-0 d-flex align-items-center text-white" style="font-size: 0.75rem;" title="Email Invoice via SendGrid"><i class="bi bi-envelope me-1"></i> Email</button>
                                        </form>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Super Admin") || User.IsInRole("Billing Staff"))
                                        {
                                            @if (!isBillingArchived)
                                            {
                                                <form asp-action="ArchiveInvoice" asp-route-id="@invoice.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0" style="font-size:0.75rem;" title="Archive">
                                                        <i class="bi bi-archive"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="UnarchiveInvoice" asp-route-id="@invoice.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2 py-0" style="font-size:0.75rem;" title="Restore">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

