@model ClientSphere.ViewModels.SalesManagerDashboardViewModel

@{
    ViewData["Title"] = "Sales Manager Dashboard";
    ViewData["HideTopNavTitle"] = true;
    Layout = "~/Views/Shared/_CrmLayout.cshtml";
    ViewData["CurrentPage"] = "Dashboard";
}

<!-- Header removed to prevent duplication with Layout -->

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-3 me-3">
                    <i class="h4 mb-0 fw-bold">&#8369;</i>
                </div>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2">
                    <i class="bi bi-arrow-up-short"></i> @Model.RevenueGrowth%
                </span>
            </div>
            <h3 class="fw-bold mb-0">&#8369;@Model.TotalRevenueMTD.ToString("N0")K</h3>
            <div class="text-muted small">Total Revenue (MTD)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-3 me-3">
                    <i class="bi bi-bullseye h4 mb-0"></i>
                </div>
                <span class="text-primary fw-bold small">85%</span>
            </div>
            <h3 class="fw-bold mb-0">&#8369;253K</h3>
            <div class="text-muted small">Quota Achievement</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100">
             <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-3 me-3">
                    <i class="bi bi-graph-up-arrow h4 mb-0"></i>
                </div>
                 <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2">
                    <i class="bi bi-arrow-up-short"></i> @Model.DealsGrowth%
                </span>
            </div>
            <h3 class="fw-bold mb-0">@Model.DealsClosedMTD</h3>
            <div class="text-muted small">Deals Closed (MTD)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100">
             <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="icon-shape bg-secondary-subtle text-secondary rounded-3 p-3 me-3">
                    <i class="bi bi-people h4 mb-0"></i>
                </div>
                <span class="text-muted small">3 members</span>
            </div>
            <h3 class="fw-bold mb-0">&#8369;@((Model.AvgDealSize/1000).ToString("N0"))K</h3>
            <div class="text-muted small">Avg Deal Size</div>
        </div>
    </div>
</div>

<!-- Team Performance -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Team Performance</h5>
        <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All Sales &rarr;</a>
    </div>
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @foreach (var person in Model.TeamPerformance)
            {
                <div class="list-group-item border-0 py-3 px-4 d-flex align-items-center">
                    <div class="me-3">
                        <span class="badge rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">#@person.Rank</span>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold">@person.Name</div>
                        <div class="small text-muted">@person.Role</div>
                    </div>
                    <div class="text-end me-4">
                        <div class="fw-bold">&#8369;@((person.TotalSales/1000).ToString("N0"))K</div>
                        <div class="small text-muted">@person.DealsCount deals</div>
                    </div>
                    <div class="text-end" style="width: 80px;">
                        @if(person.Growth > 0)
                        {
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">
                                <i class="bi bi-arrow-up-short"></i> @person.Growth%
                            </span>
                        }
                        else
                        {
                             <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">
                                <i class="bi bi-arrow-down-short"></i> @Math.Abs(person.Growth)%
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>


<!-- Bottom Actions Grid -->
<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm h-100 hover-card cursor-pointer" onclick="window.location.href='@Url.Action("Index", "Sales")'">
            <div class="card-body">
                <i class="bi bi-bar-chart-line h3 text-secondary mb-3 d-block"></i>
                <h5 class="fw-bold">View Sales Reports</h5>
                <p class="text-muted small mb-0">Detailed analytics and pipeline reports</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm h-100 hover-card cursor-pointer" onclick="window.location.href='@Url.Action("Index", "Customers")'">
            <div class="card-body">
                <i class="bi bi-people h3 text-secondary mb-3 d-block"></i>
                <h5 class="fw-bold">Customer Database</h5>
                <p class="text-muted small mb-0">Access customer information</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm h-100 hover-card cursor-pointer" onclick="window.location.href='@Url.Action("AllLeads", "SalesManager")'">
            <div class="card-body">
                <i class="bi bi-funnel h3 text-secondary mb-3 d-block"></i>
                <h5 class="fw-bold">View Team Leads</h5>
                <p class="text-muted small mb-0">Monitor new and active leads</p>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card:hover {
        transform: translateY(-5px);
        transition: transform 0.2s ease;
    }
</style>

