@model IEnumerable<ClientSphere.Models.Opportunity>
@{
    ViewData["Title"] = "All Team Opportunities";
    ViewData["HideTopNavTitle"] = true;
    Layout = "~/Views/Shared/_CrmLayout.cshtml";
    ViewData["CurrentPage"] = "AllOpportunities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">All Team Opportunities</h2>
        <p class="text-muted mb-0">Full pipeline view across the entire sales team.</p>
    </div>
    <a asp-controller="SalesManager" asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>

@{
    var totalValue = Model.Where(o => o.Stage == "Closed Won").Sum(o => o.EstimatedValue);
    var totalPipeline = Model.Sum(o => o.EstimatedValue);
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small">Total Pipeline Value</div>
            <h4 class="fw-bold mb-0 text-dark">&#8369;@totalPipeline.ToString("N0")</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small">Closed Won Revenue</div>
            <h4 class="fw-bold mb-0 text-dark">&#8369;@totalValue.ToString("N0")</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small">Total Opportunities</div>
            <h4 class="fw-bold mb-0 text-dark">@Model.Count()</h4>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Opportunity Name</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th class="text-end">Value</th>
                        <th>Close Date</th>
                        <th>Assigned To</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-graph-up-arrow display-4 mb-3 d-block"></i>
                                <h5>No opportunities found</h5>
                            </td>
                        </tr>
                    }
                    @foreach (var opp in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@opp.Name</td>
                            <td>
                                @if(opp.Stage == "Closed Won") { <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Closed Won</span> }
                                else if(opp.Stage == "Negotiation") { <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">Negotiation</span> }
                                else if(opp.Stage == "Proposal") { <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3">Proposal</span> }
                                else { <span class="badge bg-secondary text-light rounded-pill px-3">@opp.Stage</span> }
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @opp.Probability%"></div>
                                    </div>
                                    <span class="small text-muted">@opp.Probability%</span>
                                </div>
                            </td>
                            <td class="text-end fw-bold">&#8369;@opp.EstimatedValue.ToString("N0")</td>
                            <td>@opp.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">
                                    <i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(opp.AssignedToUserId) ? "Unassigned" : $"Staff {opp.AssignedToUserId.Substring(0, 6)}...")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="SalesManager" asp-action="EditOpportunity" asp-route-id="@opp.Id" class="btn btn-sm btn-outline-primary" title="Edit & Reassign">
                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
