@model IEnumerable<ClientSphere.Models.Appointment>
@{
    ViewData["Title"] = "All Team Appointments";
    ViewData["HideTopNavTitle"] = true;
    Layout = "~/Views/Shared/_CrmLayout.cshtml";
    ViewData["CurrentPage"] = "AllAppointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">All Team Appointments</h2>
        <p class="text-muted mb-0">Full calendar view across the entire sales team.</p>
    </div>
    <div class="col-md-6 text-md-end">
        <a asp-controller="SalesManager" asp-action="CreateAppointment" class="btn btn-primary shadow-sm me-2">
            <i class="bi bi-plus-lg me-2"></i>Schedule Meeting
        </a>
        <a asp-controller="SalesManager" asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Title</th>
                        <th>Customer</th>
                        <th>Date & Time</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Organized By</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x display-4 mb-3 d-block"></i>
                                <h5>No appointments found</h5>
                                <p>Appointments created by Sales Staff will appear here.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Title</td>
                            <td>@(item.Customer?.ContactName ?? "-")</td>
                            <td>
                                <div>@item.StartTime.ToString("MMM dd, yyyy")</div>
                                <small class="text-muted">@item.StartTime.ToString("h:mm tt") - @item.EndTime.ToString("h:mm tt")</small>
                            </td>
                            <td>@item.Location</td>
                            <td>
                                @if (item.Status == "Scheduled")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">Scheduled</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Completed</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">@item.Status</span>
                                }
                            </td>
                            <td>
                                @{
                                    var staffDict = ViewBag.StaffUsers as Dictionary<string, string>;
                                    var staffName = (staffDict != null && !string.IsNullOrEmpty(item.OrganizerUserId) && staffDict.ContainsKey(item.OrganizerUserId)) 
                                        ? staffDict[item.OrganizerUserId] 
                                        : "Unknown";
                                }
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">
                                    <i class="bi bi-person me-1"></i>@staffName
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="SalesManager" asp-action="EditAppointment" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
