@model IEnumerable<ClientSphere.Models.Invoice>

@{
    ViewData["Title"] = "Billing Dashboard";
    ViewData["HideTopNavTitle"] = true;
    Layout = "~/Views/Shared/_CrmLayout.cshtml";
    ViewData["CurrentPage"] = "Dashboard";
    int processingCount = (int)(ViewBag.ProcessingCount ?? 0);
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Billing Dashboard</h3>
            <p class="text-muted mb-0">Overview of invoices and payment activity</p>
        </div>
    </div>

    @* Processing Alert *@
    @if (processingCount > 0)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4 p-3" role="alert">
            <i class="bi bi-bell-fill fs-4 flex-shrink-0"></i>
            <div>
                <strong>@processingCount invoice@(processingCount > 1 ? "s" : "") awaiting confirmation.</strong>
                <span class="text-muted ms-1">Review below and click <strong>Mark Paid</strong> or <strong>Edit</strong> to set as Partial.</span>
            </div>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="small text-muted mb-1">Total Invoices</div>
                <h3 class="fw-bold mb-0">@ViewBag.TotalInvoices</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="small text-muted mb-1">Awaiting Confirmation</div>
                <h3 class="fw-bold mb-0">@ViewBag.ProcessingCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="small text-muted mb-1">Paid This Month</div>
                <h3 class="fw-bold mb-0">&#8369;@(((decimal)(ViewBag.PaidThisMonth ?? 0m)).ToString("N0"))</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="small text-muted mb-1">Overdue Invoices</div>
                <h3 class="fw-bold mb-0">@ViewBag.OverdueCount</h3>
            </div>
        </div>
    </div>

    <!-- Processing Invoices Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
            <span class="fw-bold">Invoices Awaiting Confirmation</span>
            <a asp-controller="Billing" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All Invoices</a>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="text-uppercase text-muted small">
                                <th class="ps-4 border-0">Invoice</th>
                                <th class="border-0">Customer</th>
                                <th class="border-0">Amount</th>
                                <th class="border-0">Payment Method</th>
                                <th class="border-0">Due Date</th>
                                <th class="pe-4 border-0 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">
                                        @inv.InvoiceNumber
                                        <div class="small fw-normal text-muted">@inv.IssueDate.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>@(inv.Customer?.ContactName ?? "Unknown")</td>
                                    <td class="fw-bold">&#8369;@inv.Amount.ToString("N2")</td>
                                    <td>@(inv.PaymentMethod ?? "—")</td>
                                    <td>@inv.DueDate.ToString("MMM dd, yyyy")</td>
                                    <td class="pe-4 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-controller="Billing" asp-action="MarkAsPaid" asp-route-id="@inv.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" style="font-size:0.75rem;">Mark Paid</button>
                                            </form>
                                            <a asp-controller="Billing" asp-action="Edit" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3" style="font-size:0.75rem;">Edit</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-check2-circle display-4 text-muted mb-3 d-block"></i>
                    <p class="text-muted mb-0">No invoices awaiting confirmation.</p>
                </div>
            }
        </div>
    </div>
</div>
