@model ClientSphere.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    ViewData["HideTopNavTitle"] = true;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var displayName = $"{Model.FirstName} {Model.LastName}".Trim();
    var initials = (!string.IsNullOrWhiteSpace(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : "")
                 + (!string.IsNullOrWhiteSpace(Model.LastName)  ? Model.LastName.Substring(0, 1).ToUpper()  : "");
    if (string.IsNullOrWhiteSpace(initials)) initials = "U";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Profile Hero Banner -->
<div class="card border-0 shadow-sm mb-4 overflow-hidden">
    <div style="height: 100px; background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);"></div>
    <div class="card-body pt-0">
        <div class="d-flex align-items-end gap-4 mt-n5 mb-3">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile" class="rounded-circle border border-3 border-white shadow"
                     style="width: 90px; height: 90px; object-fit: cover; flex-shrink: 0;">
            }
            else
            {
                <div class="rounded-circle border border-3 border-white shadow bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                     style="width: 90px; height: 90px; font-size: 2rem; flex-shrink: 0;">
                    @initials
                </div>
            }
            <div class="pb-1">
                <h5 class="fw-bold mb-0">@(string.IsNullOrWhiteSpace(displayName) ? "Customer" : displayName)</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1" style="font-size: 0.75rem;">
                    Premium Member
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Edit Profile Form -->
<form asp-action="MyProfile" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-4">
        <div class="col-lg-7 d-flex flex-column gap-4">
            <!-- Personal Information -->
            <div class="card border-0 shadow-sm">
                <div class="card-header border-0 py-3 d-flex align-items-center gap-2">
                    <div class="rounded-2 p-2" style="background: rgba(13,110,253,0.12);">
                        <i class="bi bi-person-fill text-primary"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Personal Information</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 mb-2">
                            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Profile Picture <i class="bi bi-cloud-upload ms-1 text-primary"></i></label>
                            <input type="file" name="profilePicture" class="form-control" accept="image/*" />
                            <div class="form-text small">Optional. Upload a new image to change your avatar via Cloudinary.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">First Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" name="firstName" value="@Model.FirstName" class="form-control" placeholder="First name" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Last Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" name="lastName" value="@Model.LastName" class="form-control" placeholder="Last name" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" value="@Model.Email" class="form-control" placeholder="user@example.com" disabled readonly />
                            </div>
                            <div class="form-text small">Email address cannot be changed here.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input type="tel" name="phoneNumber" value="@Model.PhoneNumber" class="form-control" placeholder="+63 9XX XXX XXXX" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Info (read-only) -->
            <div class="card border-0 shadow-sm">
                <div class="card-header border-0 py-3 d-flex align-items-center gap-2">
                    <div class="rounded-2 p-2" style="background: rgba(25,135,84,0.12);">
                        <i class="bi bi-shield-check-fill text-success"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Account Details</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Account Status</label>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <i class="bi bi-circle-fill text-success" style="font-size: 0.6rem;"></i>
                                <span class="fw-semibold">Active</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">Member Since</label>
                            <div class="fw-semibold">@Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <!-- Security Settings -->
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header border-0 py-3 d-flex align-items-center gap-2">
                    <div class="rounded-2 p-2" style="background: rgba(220,53,69,0.12);">
                        <i class="bi bi-shield-lock-fill text-danger"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Security Settings</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-4">Manage your account security, passwords, and two-factor authentication.</p>
                    
                    <div class="d-flex flex-column gap-3">
                        <a href="/Identity/Account/Manage/ChangePassword" class="btn btn-outline-secondary d-flex align-items-center justify-content-between p-3 rounded-3" style="text-decoration: none;">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-key fs-4 text-warning"></i>
                                <div class="text-start">
                                    <div class="fw-bold text-dark mb-1">Change Password</div>
                                    <div class="small text-muted" style="line-height: 1;">Update your account password</div>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>

                        <a href="/Identity/Account/Manage/TwoFactorAuthentication" class="btn btn-outline-secondary d-flex align-items-center justify-content-between p-3 rounded-3" style="text-decoration: none;">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-shield-check fs-4 text-success"></i>
                                <div class="text-start">
                                    <div class="fw-bold text-dark mb-1">Two-Factor Auth (2FA)</div>
                                    <div class="small text-muted" style="line-height: 1;">Enable extra security via Email</div>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-check-lg me-1"></i> Save Changes
        </button>
    </div>
</form>

