@model ClientSphere.Models.Opportunity
@{
    ViewData["Title"] = "Edit Opportunity";
    Layout = "~/Views/Shared/_CrmLayout.cshtml";
    ViewData["CurrentPage"] = "MyOpportunities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Edit Opportunity</h2>
        <p class="text-muted mb-0">Update potential sale details</p>
    </div>
    <a asp-action="MyOpportunities" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to List</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="EditOpportunity">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label fw-medium"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. 500 Unit Order for Acme Corp" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="EstimatedValue" class="form-label fw-medium"></label>
                    <div class="input-group">
                        <span class="input-group-text">&#8369;</span>
                        <input asp-for="EstimatedValue" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="EstimatedValue" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="ExpectedCloseDate" class="form-label fw-medium"></label>
                    <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                    <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Stage" class="form-label fw-medium"></label>
                    <select asp-for="Stage" class="form-select">
                        <option value="Prospecting">Prospecting</option>
                        <option value="Qualification">Qualification</option>
                        <option value="Proposal">Proposal</option>
                        <option value="Negotiation">Negotiation</option>
                        <option value="Closed Won">Closed Won</option>
                        <option value="Closed Lost">Closed Lost</option>
                    </select>
                    <span asp-validation-for="Stage" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Probability" class="form-label fw-medium"></label>
                    <div class="input-group">
                        <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="Probability" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                <a asp-action="MyOpportunities" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
