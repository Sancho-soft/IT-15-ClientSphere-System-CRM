@model ClientSphere.Models.Lead
@{
    ViewData["Title"] = "Create Lead";
    Layout = "~/Views/Shared/_CrmLayout.cshtml";
    ViewData["CurrentPage"] = "MyLeads";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">New Lead</h2>
        <p class="text-muted mb-0">Add a new prospective customer</p>
    </div>
    <a asp-action="MyLeads" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to List</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="CreateLead">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label fw-medium"></label>
                    <input asp-for="FirstName" class="form-control" placeholder="John" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label fw-medium"></label>
                    <input asp-for="LastName" class="form-control" placeholder="Doe" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-medium"></label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="john@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-medium"></label>
                    <input asp-for="Phone" class="form-control" placeholder="+1 234 567 8900" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                
                <div class="col-12">
                    <label asp-for="Company" class="form-label fw-medium"></label>
                    <input asp-for="Company" class="form-control" placeholder="Acme Inc." />
                    <span asp-validation-for="Company" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Source" class="form-label fw-medium"></label>
                    <select asp-for="Source" class="form-select">
                        <option value="">Select a source...</option>
                        <option value="Website">Website</option>
                        <option value="Referral">Referral</option>
                        <option value="Cold Call">Cold Call</option>
                        <option value="LinkedIn">LinkedIn</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Source" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-medium"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="New">New</option>
                        <option value="Contacted">Contacted</option>
                        <option value="Qualified">Qualified</option>
                        <option value="Lost">Lost</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="mt-4 pt-3 border-top text-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Save Lead</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
