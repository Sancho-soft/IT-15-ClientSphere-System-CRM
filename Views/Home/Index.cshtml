@{
    ViewData["Title"] = "Home Page";
    ViewData["HideTopNavTitle"] = true;
}

<div class="container py-5">
    <div class="row align-items-center g-5 py-5">
        <div class="col-lg-6 hero-text-anim">
            <h1 class="display-4 fw-bold lh-1 mb-3 text-primary">ClientSphere - A Friendly Customer Management</h1>
            <p class="lead">
                A comprehensive CRM platform designed for sales and service-oriented businesses. Manage customer interactions, track sales, handle support tickets, run marketing campaigns, and integrate billing &mdash; all in one centralized system.
            </p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                @if (User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Super Admin"))
                    {
                        <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Go to Dashboard</a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Go to Dashboard</a>
                    }
                    else if (User.IsInRole("Sales Manager"))
                    {
                        <a asp-action="Dashboard" asp-controller="SalesManager" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Go to Dashboard</a>
                    }
                    else if (User.IsInRole("Sales Staff"))
                    {
                        <a asp-action="Dashboard" asp-controller="SalesStaff" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Go to Dashboard</a>
                    }
                    else if (User.IsInRole("Support Staff"))
                    {
                        <a asp-action="Dashboard" asp-controller="SupportStaff" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Go to Dashboard</a>
                    }
                    else if (User.IsInRole("Marketing Staff") || User.IsInRole("Marketing Manager"))
                    {
                         <a asp-action="Dashboard" asp-controller="MarketingStaff" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Go to Dashboard</a>
                    }
                    else if (User.IsInRole("Billing Staff"))
                    {
                         <a asp-action="Index" asp-controller="Billing" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Go to Dashboard</a>
                    }
                     else if (User.IsInRole("Customer"))
                    {
                         <a asp-action="Dashboard" asp-controller="CustomerPortal" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Go to Portal</a>
                    }
                    else
                    {
                         <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">My Account</a>
                    }
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">Get Started</a>
                }
                <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary btn-lg px-4">About Clientsphere</a>
            </div>
        </div>
        <div class="col-lg-6 hero-carousel-anim">
            <div id="heroCarousel" class="carousel slide shadow rounded-3 overflow-hidden" data-bs-ride="carousel" data-bs-interval="3000">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="~/images/carousel-1.jpg" class="d-block w-100" alt="Professional Team" style="height: 400px; object-fit: cover;">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/carousel-2.jpg" class="d-block w-100" alt="Business Growth" style="height: 400px; object-fit: cover;">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/carousel-3.jpg" class="d-block w-100" alt="Client Success" style="height: 400px; object-fit: cover;">
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>

    <div class="row text-center mt-5 gsap-stagger-container" id="features-crm">
        <div class="col-lg-4 gsap-stagger-item">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="feature-icon bg-primary bg-gradient text-white rounded-3 mb-3 d-inline-block p-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <h2>Customer Data</h2>
                    <p>Centralize your customer contact details and interaction history.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 gsap-stagger-item" id="features-sales">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="feature-icon bg-primary bg-gradient text-white rounded-3 mb-3 d-inline-block p-3">
                        <i class="bi bi-graph-up-arrow fs-3"></i>
                    </div>
                    <h2>Sales Tracking</h2>
                    <p>Monitor opportunities, manage orders, and analyze sales performance.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 gsap-stagger-item" id="features-marketing">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="feature-icon bg-primary bg-gradient text-white rounded-3 mb-3 d-inline-block p-3">
                        <i class="bi bi-credit-card-2-front-fill fs-3"></i>
                    </div>
                    <h2>Billing & Invoices</h2>
                    <p>Generate invoices and process payments seamlessly.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Solutions Section -->
<section id="solutions-smb" class="py-5 gsap-slide-up">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2 class="fw-bold mb-3">Built for Small Business</h2>
                <p class="text-muted">ClientSphere gives small teams the same powerful CRM tools used by enterprise companies &mdash; without the complexity or cost. Manage customers, track sales, and send invoices all from one place.</p>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary mt-2">Start Free <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
            <div class="col-lg-6 text-center">
                <i class="bi bi-shop text-primary landing-float-icon" style="font-size: 6rem;"></i>
            </div>
        </div>
    </div>
</section>

<section id="solutions-enterprise" class="py-5 gsap-slide-up">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 text-center order-lg-1">
                <i class="bi bi-building text-primary landing-float-icon" style="font-size: 6rem;"></i>
            </div>
            <div class="col-lg-6 order-lg-2">
                <h2 class="fw-bold mb-3">Enterprise-Grade Control</h2>
                <p class="text-muted">Advanced role-based access control, full audit logging, and multi-team module management give enterprise organizations the visibility and governance they need.</p>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary mt-2">Request a Demo <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="py-5 gsap-fade-in">
    <div class="container text-center" style="max-width: 700px;">
        <h2 class="fw-bold mb-3">Our Story</h2>
        <p class="text-muted lead">ClientSphere was built to solve a simple problem: growing businesses drowning in spreadsheets. Our team of developers and business consultants created a unified CRM that's powerful yet easy to use &mdash; giving every team member the right tools for their role.</p>
        <div class="row mt-4 text-center gsap-stagger-container">
            <div class="col-4 gsap-stagger-item"><h3 class="fw-bold text-primary counter-anim" data-target="9" data-suffix="+">0</h3><small class="text-muted">User Roles</small></div>
            <div class="col-4 gsap-stagger-item"><h3 class="fw-bold text-primary counter-anim" data-target="5" data-suffix="+">0</h3><small class="text-muted">Core Modules</small></div>
            <div class="col-4 gsap-stagger-item"><h3 class="fw-bold text-primary counter-anim" data-target="100" data-suffix="%">0</h3><small class="text-muted">Role-Based Access</small></div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-5 gsap-slide-up">
    <div class="container text-center" style="max-width: 600px;">
        <h2 class="fw-bold mb-3">Get In Touch</h2>
        <p class="text-muted">Have questions about ClientSphere? Reach out to our team and we'll get back to you within 24 hours.</p>
        <a href="mailto:support@clientsphere.com" class="btn btn-primary btn-lg mt-2">
            <i class="bi bi-envelope me-2"></i>Contact Us
        </a>
        <p class="mt-4 text-muted small">Or email us directly at <a href="mailto:support@clientsphere.com">support@clientsphere.com</a></p>
    </div>
</section>

@section Scripts {
    <style>
        .landing-float-icon {
            display: inline-block;
            animation: floatUpDown 3s ease-in-out infinite;
        }
        @@keyframes floatUpDown {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .feature-icon {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card:hover .feature-icon {
            transform: scale(1.15) rotate(-5deg);
            box-shadow: 0 8px 25px rgba(13, 110, 253, 0.3);
        }
        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12) !important;
        }
    </style>
    <style>
        #cs-chat-launcher {
            position: fixed; bottom: 28px; right: 28px; z-index: 9999;
            width: 58px; height: 58px; border-radius: 50%;
            background: #1a56db; border: none; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 20px rgba(26,86,219,0.45);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        #cs-chat-launcher:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(26,86,219,0.6); }
        #cs-chat-launcher i { color: #fff; font-size: 1.5rem; transition: transform 0.3s ease; }
        #cs-chat-launcher.open i { transform: rotate(45deg); }
        #cs-chat-panel {
            position: fixed; bottom: 100px; right: 28px; z-index: 9998;
            width: 360px; max-height: 540px; border-radius: 16px;
            background: #fff; box-shadow: 0 12px 48px rgba(0,0,0,0.18);
            display: flex; flex-direction: column; overflow: hidden;
            transform: translateY(20px) scale(0.97); opacity: 0;
            pointer-events: none; transition: transform 0.25s ease, opacity 0.25s ease;
        }
        #cs-chat-panel.open { transform: translateY(0) scale(1); opacity: 1; pointer-events: all; }
        .cs-chat-header { background: #1a56db; color: #fff; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
        .cs-chat-header-info { display: flex; align-items: center; gap: 10px; }
        .cs-chat-avatar { width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
        .cs-chat-title { font-weight: 700; font-size: 0.95rem; }
        .cs-chat-subtitle { font-size: 0.72rem; opacity: 0.85; }
        .cs-chat-close-btn { background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; opacity: 0.85; padding: 4px; border-radius: 50%; transition: background 0.15s; }
        .cs-chat-close-btn:hover { background: rgba(255,255,255,0.2); opacity: 1; }
        #cs-chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; background: #f8faff; }
        .cs-date-label { text-align: center; font-size: 0.7rem; color: #6b7280; background: #e5e7eb; border-radius: 20px; padding: 3px 12px; align-self: center; }
        .cs-msg { display: flex; gap: 8px; max-width: 90%; }
        .cs-msg.bot { align-self: flex-start; }
        .cs-msg.user { align-self: flex-end; flex-direction: row-reverse; }
        .cs-msg-avatar { width: 30px; height: 30px; min-width: 30px; border-radius: 50%; background: #1a56db; color: #fff; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; }
        .cs-msg-bubble { padding: 10px 13px; border-radius: 14px; font-size: 0.83rem; line-height: 1.5; }
        .cs-msg.bot .cs-msg-bubble { background: #fff; color: #111827; border-bottom-left-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); }
        .cs-msg.user .cs-msg-bubble { background: #1a56db; color: #fff; border-bottom-right-radius: 4px; }
        .cs-msg-time { font-size: 0.68rem; opacity: 0.5; margin-top: 4px; }
        /* Typing indicator */
        .cs-typing-bubble { display: flex; gap: 8px; align-self: flex-start; }
        .cs-typing-dots {
            background: #fff; border-bottom-left-radius: 4px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.07);
            padding: 12px 16px; border-radius: 14px;
            display: flex; align-items: center; gap: 5px; height: 38px;
        }
        .cs-typing-dots span {
            width: 7px; height: 7px; border-radius: 50%;
            background: #9ca3af; display: inline-block;
            animation: cs-bounce 1.2s infinite ease-in-out;
        }
        .cs-typing-dots span:nth-child(2) { animation-delay: 0.2s; }
        .cs-typing-dots span:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes cs-bounce {
            0%, 60%, 100% { transform: translateY(0); }
            30% { transform: translateY(-6px); }
        }
        .cs-quick-actions { padding: 0 16px 10px; display: flex; flex-wrap: wrap; gap: 8px; background: #f8faff; }
        .cs-quick-btn { font-size: 0.78rem; padding: 5px 12px; border-radius: 20px; border: 1px solid #1a56db; background: transparent; color: #1a56db; cursor: pointer; transition: background 0.15s, color 0.15s; }
        .cs-quick-btn:hover { background: #1a56db; color: #fff; }
        .cs-chat-input-area { border-top: 1px solid #e5e7eb; padding: 10px 12px; display: flex; gap: 8px; flex-shrink: 0; align-items: center; background: #fff; }
        #cs-chat-input { flex: 1; border: 1px solid #e5e7eb; border-radius: 20px; padding: 8px 14px; font-size: 0.83rem; background: #f3f4f6; color: #111; outline: none; resize: none; }
        #cs-chat-input:focus { border-color: #1a56db; }
        #cs-chat-send { width: 36px; height: 36px; border-radius: 50%; background: #1a56db; border: none; color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.15s; }
        #cs-chat-send:hover { background: #1648c0; }
        #cs-chat-send:disabled { background: #9ca3af; cursor: not-allowed; }
        .cs-chat-footer { text-align: center; font-size: 0.65rem; color: #9ca3af; padding: 6px 0 8px; background: #fff; }
        @@media (max-width: 480px) { #cs-chat-panel { width: calc(100vw - 32px); right: 16px; } #cs-chat-launcher { bottom: 20px; right: 20px; } }
    </style>

    <button id="cs-chat-launcher" title="Support Chat" onclick="toggleCsChat()">
        <i class="bi bi-chat-dots-fill" id="cs-chat-launcher-icon"></i>
    </button>

    <div id="cs-chat-panel">
        <div class="cs-chat-header">
            <div class="cs-chat-header-info">
                <div class="cs-chat-avatar"><i class="bi bi-headset"></i></div>
                <div>
                    <div class="cs-chat-title">ClientSphere Support</div>
                    <div class="cs-chat-subtitle">We typically reply within 1 business day</div>
                </div>
            </div>
            <button class="cs-chat-close-btn" onclick="toggleCsChat()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div id="cs-chat-messages">
            <div class="cs-date-label" id="cs-date-label"></div>
            <div class="cs-msg bot">
                <div class="cs-msg-avatar"><i class="bi bi-robot"></i></div>
                <div>
                    <div class="cs-msg-bubble">Hi! I'm the <strong>ClientSphere</strong> support assistant. How can I help you today?</div>
                    <div class="cs-msg-time" id="cs-bot-time"></div>
                </div>
            </div>
        </div>
        <div class="cs-quick-actions" id="cs-quick-actions">
            <button class="cs-quick-btn" onclick="csQuickAction('Tell me about ClientSphere')">About</button>
            <button class="cs-quick-btn" onclick="csQuickAction('I need technical support')">Tech Support</button>
            <button class="cs-quick-btn" onclick="csQuickAction('How do I sign up?')">Sign Up</button>
            <button class="cs-quick-btn" onclick="csQuickAction('I want to contact sales')">Sales</button>
        </div>
        <div class="cs-chat-input-area">
            <textarea id="cs-chat-input" rows="1" placeholder="Write your message..." onkeydown="csChatKeydown(event)"></textarea>
            <button id="cs-chat-send" onclick="csSendMessage()"><i class="bi bi-send-fill"></i></button>
        </div>
        <div class="cs-chat-footer">POWERED BY CLIENTSPHERE</div>
    </div>

    <script>
        let csChatOpen = false;
        (function () {
            const now = new Date();
            const dl = document.getElementById('cs-date-label');
            const bt = document.getElementById('cs-bot-time');
            if (dl) dl.textContent = now.toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            if (bt) bt.textContent = now.toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' });
        })();

        function toggleCsChat() {
            csChatOpen = !csChatOpen;
            document.getElementById('cs-chat-panel').classList.toggle('open', csChatOpen);
            document.getElementById('cs-chat-launcher').classList.toggle('open', csChatOpen);
            document.getElementById('cs-chat-launcher-icon').className = csChatOpen ? 'bi bi-x-lg' : 'bi bi-chat-dots-fill';
            if (csChatOpen) document.getElementById('cs-chat-input').focus();
        }

        function csAddMsg(text, from) {
            const msgs = document.getElementById('cs-chat-messages');
            const qs = document.getElementById('cs-quick-actions');
            if (qs) qs.style.display = 'none';
            const div = document.createElement('div');
            div.className = `cs-msg ${from}`;
            const now = new Date().toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' });
            if (from === 'bot') {
                div.innerHTML = `<div class="cs-msg-avatar"><i class="bi bi-robot"></i></div><div><div class="cs-msg-bubble">${text}</div><div class="cs-msg-time">${now}</div></div>`;
            } else {
                div.innerHTML = `<div><div class="cs-msg-bubble">${text}</div><div class="cs-msg-time text-end">${now}</div></div>`;
            }
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function csShowTyping() {
            const msgs = document.getElementById('cs-chat-messages');
            const typingDiv = document.createElement('div');
            typingDiv.className = 'cs-typing-bubble';
            typingDiv.id = 'cs-typing-indicator';
            typingDiv.innerHTML = `<div class="cs-msg-avatar"><i class="bi bi-robot"></i></div><div class="cs-typing-dots"><span></span><span></span><span></span></div>`;
            msgs.appendChild(typingDiv);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function csHideTyping() {
            const el = document.getElementById('cs-typing-indicator');
            if (el) el.remove();
        }

        function csQuickAction(text) { csAddMsg(text, 'user'); csTriggerTyping(text); }
        function csSendMessage() {
            const inp = document.getElementById('cs-chat-input');
            const text = inp.value.trim();
            if (!text) return;
            inp.value = '';
            csAddMsg(text, 'user');
            csTriggerTyping(text);
        }
        function csChatKeydown(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); csSendMessage(); } }

        function csTriggerTyping(userText) {
            const sendBtn = document.getElementById('cs-chat-send');
            const inp = document.getElementById('cs-chat-input');
            if (sendBtn) sendBtn.disabled = true;
            if (inp) inp.disabled = true;
            csShowTyping();
            // Random delay 1.0 - 1.8s for natural feel
            const delay = 1000 + Math.random() * 800;
            setTimeout(() => {
                csHideTyping();
                csBotRespond(userText);
                if (sendBtn) sendBtn.disabled = false;
                if (inp) { inp.disabled = false; inp.focus(); }
            }, delay);
        }

        function csBotRespond(userText) {
            const lower = userText.toLowerCase();

            // ── About / General Info ──────────────────────────────────
            if (lower.includes('about') || lower.includes('what is clientsphere') || lower.includes('tell me about')) {
                csAddMsg('ClientSphere is a full-featured CRM platform for managing customers, leads, sales, marketing campaigns, billing, and support — all in one place. It supports 9+ user roles and is accessible from any modern browser.', 'bot');

            // ── Account & Registration ────────────────────────────────
            } else if (lower.includes('sign up') || lower.includes('register') || lower.includes('create account') || lower.includes('new account')) {
                csAddMsg('You can create a customer account here: <a href="/Identity/Account/Register" class="text-primary fw-semibold">Register Now</a><br><br>Fill in your name, email, phone number, and address to get started. All new accounts are assigned the Customer role by default.', 'bot');

            // ── Login / Sign In ───────────────────────────────────────
            } else if (lower.includes('login') || lower.includes('log in') || lower.includes('sign in') || lower.includes('cant login') || lower.includes("can't log")) {
                csAddMsg('You can log in here: <a href="/Identity/Account/Login" class="text-primary fw-semibold">Sign In</a><br><br>If you are having trouble logging in, make sure:<br>• You are using the correct email address<br>• Your Caps Lock is off<br>• You have completed the security check (Cloudflare Turnstile)<br><br>If the problem persists, use <strong>"Forgot Password"</strong> on the login page.', 'bot');

            // ── Password Reset ────────────────────────────────────────
            } else if (lower.includes('forgot password') || lower.includes('reset password') || lower.includes('change password') || lower.includes('password')) {
                csAddMsg('To reset your password:<br>1. Go to the <a href="/Identity/Account/Login" class="text-primary fw-semibold">Login page</a><br>2. Click <strong>"Forgot your password?"</strong><br>3. Enter your registered email address<br>4. Check your inbox for a reset link<br><br>If you did not receive the email, check your spam folder or contact <a href="mailto:support@clientsphere.com" class="text-primary fw-semibold">support@clientsphere.com</a>.', 'bot');

            // ── Invoice / Billing ─────────────────────────────────────
            } else if (lower.includes('invoice') || lower.includes('billing') || lower.includes('bill') || lower.includes('charge') || lower.includes('overcharged')) {
