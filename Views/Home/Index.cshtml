    <script>
        // Landing page custom GSAP animations
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof gsap === 'undefined') return;

            // Register ScrollTrigger plugin
            if (typeof ScrollTrigger !== 'undefined') {
                gsap.registerPlugin(ScrollTrigger);
            }

            // Hero text slide from left
            gsap.from('.hero-text-anim', {
                x: -80, opacity: 0, duration: 1, ease: 'power3.out', delay: 0.2
            });

            // Hero carousel slide from right
            gsap.from('.hero-carousel-anim', {
                x: 80, opacity: 0, duration: 1, ease: 'power3.out', delay: 0.4
            });

            // Counter animation on scroll
            document.querySelectorAll('.counter-anim').forEach(function (el) {
                var target = parseInt(el.dataset.target);
                var suffix = el.dataset.suffix || '';
                var triggered = false;

                if (typeof gsap !== 'undefined' && 'IntersectionObserver' in window) {
                    var observer = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting && !triggered) {
                                triggered = true;
                                var obj = { val: 0 };
                                gsap.to(obj, {
                                    val: target,
                                    duration: 1.5,
                                    ease: 'power2.out',
                                    onUpdate: function () {
                                        el.textContent = Math.round(obj.val) + suffix;
                                    }
                                });
                                observer.unobserve(el);
                            }
                        });
                    }, { threshold: 0.1 });
                    observer.observe(el);
                } else {
                    // Fallback
                    el.textContent = target + suffix;
                }
            });
        });
    </script>
}
