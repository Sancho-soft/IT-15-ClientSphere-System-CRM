<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClientSphere Customer Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/png" href="~/images/logo.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="~/images/logo.png?v=2" />
    <script>
        (function () {
            const saved = localStorage.getItem('clientsphere-theme');
            if (saved === 'dark') document.documentElement.setAttribute('data-bs-theme', 'dark');
        })();
    </script>
    <style>
        body {
            background-color: var(--bs-body-bg);
            color: var(--bs-body-color);
        }
        .customer-sidebar {
            width: 260px;
            height: 100vh;
            background-color: var(--bs-body-bg);
            border-right: 1px solid var(--bs-border-color);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .main-content { margin-left: 260px; padding: 2rem; }
        .nav-link { color: var(--bs-body-color); font-weight: 500; padding: 0.8rem 1.5rem; display: flex; align-items: center; transition: all 0.2s ease; border-right: 3px solid transparent; }
        .nav-link:hover { color: #0d6efd; background-color: rgba(13, 110, 253, 0.06); border-right-color: rgba(13, 110, 253, 0.4); }
        .nav-link.active { color: #0d6efd; background-color: var(--bs-primary-bg-subtle); border-right-color: #0d6efd; font-weight: 600; }
        .nav-link i { font-size: 1.2rem; margin-right: 0.8rem; }
        
        @@media (max-width: 768px) {
            .customer-sidebar { left: -260px; transition: 0.3s; }
            .customer-sidebar.active { left: 0; }
            .main-content { margin-left: 0; }
            .sidebar-overlay { display: none; position: fixed; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 999; top: 0; left: 0; }
            .sidebar-overlay.active { display: block; }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div id="customerSidebar" class="customer-sidebar">
        <div class="flex-grow-1 overflow-auto">
            <div class="p-4">
                <a href="/" class="d-block mb-2 text-center">
                    <img src="~/images/logocustomer.png" alt="ClientSphere" style="max-height: 150px; width: auto; max-width: 100%;" class="img-fluid">
                </a>
                <div class="small text-uppercase text-muted fw-bold mt-3 mb-2" style="letter-spacing: 1px;">Customer Portal</div>
            </div>

            <nav class="nav flex-column mb-3">
                <a class="nav-link @(ViewData["CurrentPage"] as string == "Dashboard" ? "active" : "")" asp-controller="CustomerPortal" asp-action="Dashboard">
                    <i class="bi bi-grid-fill"></i> Overview
                </a>
                <a class="nav-link" asp-controller="CustomerPortal" asp-action="MyOrders">
                    <i class="bi bi-box-seam"></i> My Orders
                </a>
                <a class="nav-link" asp-controller="CustomerPortal" asp-action="MyInvoices">
                    <i class="bi bi-receipt"></i> Invoices
                </a>
                <a class="nav-link" asp-controller="CustomerPortal" asp-action="MyTickets">
                    <i class="bi bi-ticket-perforated"></i> Support Tickets
                </a>
            </nav>
        </div>

    </div>

    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- Main Content -->
    <div class="main-content">
        <header class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom gsap-fade-in">
            <div class="d-flex align-items-center">
                <button id="sidebarToggle" class="btn btn-outline-secondary d-md-none me-3">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    @{
                        var ctxUser = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Identity.UserManager<ClientSphere.Models.ApplicationUser>)) as Microsoft.AspNetCore.Identity.UserManager<ClientSphere.Models.ApplicationUser>;
                        var ctxAppUser = ctxUser != null ? await ctxUser.GetUserAsync(User) : null;
                        var ctxFirstName = ctxAppUser?.FirstName ?? User.Identity?.Name?.Split('@')[0] ?? "Customer";
                    }
                    <h5 class="mb-0 fw-bold">Welcome back, @ctxFirstName</h5>
                    <div class="text-muted small">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle me-2 px-2 py-1">Customer</span>
                        <i class="bi bi-calendar3 me-1"></i> <span id="customerDateTime">@DateTime.Now.ToString("dddd, MMMM d, yyyy - hh:mm tt")</span>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button id="darkModeToggleBtn" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Toggle Dark Mode" onclick="toggleCustomerDarkMode()">
                    <i id="darkModeIcon" class="bi bi-moon-stars"></i>
                </button>
                <!-- Notification Bell -->
                <div class="dropdown" id="notifDropdown">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill position-relative px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" id="notifBellBtn">
                        <i class="bi bi-bell"></i>
                        <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;display:none;">0</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1 p-0" style="min-width:320px;max-height:400px;overflow-y:auto;" id="notifList">
                        <li class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <span class="fw-semibold small">Notifications</span>
                            <button class="btn btn-link btn-sm text-muted p-0 text-decoration-none" onclick="markAllRead()" style="font-size:0.78rem;">Mark all read</button>
                        </li>
                        <li id="notifEmpty" class="text-center text-muted py-4 small">No new notifications</li>
                    </ul>
                </div>
                @if (ViewData["CurrentPage"] as string == "Support Tickets")
                {
                    <a asp-controller="CustomerPortal" asp-action="CreateTicket" class="btn btn-primary rounded-pill d-none d-md-inline-block">
                        <i class="bi bi-plus-lg me-1"></i> New Ticket
                    </a>
                }
                
                @{
                    var drpFullName = ctxAppUser != null && !string.IsNullOrWhiteSpace(ctxAppUser?.FirstName) ? $"{ctxAppUser.FirstName} {ctxAppUser.LastName}" : User.Identity?.Name;
                    var drpEmail = ctxAppUser?.Email ?? User.Identity?.Name;
                    var drpInitials = ctxAppUser != null && !string.IsNullOrWhiteSpace(ctxAppUser?.FirstName) 
                        ? $"{ctxAppUser.FirstName.Substring(0, 1).ToUpper()}{(string.IsNullOrWhiteSpace(ctxAppUser.LastName) ? "" : ctxAppUser.LastName.Substring(0, 1).ToUpper())}" 
                        : (User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "C");
                }
                
                <div class="dropdown">
                    <button class="btn btn-sm d-flex align-items-center gap-2 border rounded-pill px-3 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="max-width: 210px;">
                        @if (ctxAppUser != null && !string.IsNullOrEmpty(ctxAppUser.ProfilePictureUrl))
                        {
                            <img src="@ctxAppUser.ProfilePictureUrl" alt="Profile" class="rounded-circle" style="width: 28px; height: 28px; object-fit: cover; flex-shrink: 0;">
                        }
                        else
                        {
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem; flex-shrink: 0;">@drpInitials</div>
                        }
                        <div class="text-start overflow-hidden d-none d-md-block">
                            <div class="fw-semibold text-truncate" style="font-size: 0.82rem; line-height: 1.2;">@drpFullName</div>
                            <div class="text-muted text-truncate" style="font-size: 0.72rem;">Customer</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1" style="min-width: 200px;">
                        <li>
                            <div class="px-3 py-2 border-bottom">
                                <div class="fw-bold" style="font-size: 0.88rem;">@drpFullName</div>
                                <div class="text-muted" style="font-size: 0.78rem;">@drpEmail</div>
                            </div>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="CustomerPortal" asp-action="MyProfile">
                                <i class="bi bi-person-circle text-primary"></i> Profile Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="px-2 pb-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main role="main" class="gsap-slide-up">
            @RenderBody()
        </main>
    </div>

    <!-- ===== ClientSphere Floating Support Chat Widget ===== -->
    <style>
        /* Chat Launcher Button */
        #cs-chat-launcher {
            position: fixed;
            bottom: 28px;
            right: 28px;
            z-index: 9999;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: #1a56db;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 20px rgba(26, 86, 219, 0.45);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        #cs-chat-launcher:hover {
            transform: scale(1.08);
            box-shadow: 0 6px 28px rgba(26, 86, 219, 0.6);
        }
        #cs-chat-launcher i { color: #fff; font-size: 1.4rem; transition: transform 0.3s ease; }
        #cs-chat-launcher.open i { transform: rotate(45deg); }

        /* Unread badge on launcher */
        #cs-chat-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: #ef4444;
            color: #fff;
            border-radius: 50%;
            font-size: 0.65rem;
            font-weight: 700;
            width: 18px;
            height: 18px;
            display: none;
            align-items: center;
            justify-content: center;
        }

        /* Chat Panel */
        #cs-chat-panel {
            position: fixed;
            bottom: 100px;
            right: 28px;
            z-index: 9998;
            width: 360px;
            max-height: 560px;
            border-radius: 16px;
            background: var(--bs-body-bg);
            box-shadow: 0 12px 48px rgba(0,0,0,0.18);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transform: translateY(20px) scale(0.97);
            opacity: 0;
            pointer-events: none;
            transition: transform 0.25s ease, opacity 0.25s ease;
        }
        #cs-chat-panel.open {
            transform: translateY(0) scale(1);
            opacity: 1;
            pointer-events: all;
        }

        /* Panel Header */
        .cs-chat-header {
            background: #1a56db;
            color: #fff;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }
        .cs-chat-header-info { display: flex; align-items: center; gap: 10px; }
        .cs-chat-avatar {
            width: 38px; height: 38px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
        }
        .cs-chat-title { font-weight: 700; font-size: 0.95rem; }
        .cs-chat-subtitle { font-size: 0.72rem; opacity: 0.85; }
        .cs-chat-close-btn {
            background: none; border: none; color: #fff;
            font-size: 1.2rem; cursor: pointer; opacity: 0.85; padding: 4px;
            line-height: 1; border-radius: 50%;
            transition: background 0.15s;
        }
        .cs-chat-close-btn:hover { background: rgba(255,255,255,0.2); opacity: 1; }

        /* Messages area */
        #cs-chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: var(--bs-body-bg);
        }
        .cs-date-label {
            text-align: center;
            font-size: 0.7rem;
            color: var(--bs-secondary-color);
            background: var(--bs-secondary-bg);
            border-radius: 20px;
            padding: 3px 12px;
            align-self: center;
        }
        .cs-msg { display: flex; gap: 8px; max-width: 90%; }
        .cs-msg.bot { align-self: flex-start; }
        .cs-msg.user { align-self: flex-end; flex-direction: row-reverse; }
        .cs-msg-avatar {
            width: 30px; height: 30px; min-width: 30px;
            border-radius: 50%;
            background: #1a56db;
            color: #fff;
            font-size: 0.75rem;
            display: flex; align-items: center; justify-content: center;
        }
        .cs-msg-bubble {
            padding: 10px 13px;
            border-radius: 14px;
            font-size: 0.83rem;
            line-height: 1.5;
        }
        .cs-msg.bot .cs-msg-bubble {
            background: var(--bs-secondary-bg);
            color: var(--bs-body-color);
            border-bottom-left-radius: 4px;
        }
        .cs-msg.user .cs-msg-bubble {
            background: #1a56db;
            color: #fff;
            border-bottom-right-radius: 4px;
        }
        .cs-msg-time { font-size: 0.68rem; opacity: 0.55; margin-top: 4px; }

        /* Quick action buttons */
        .cs-quick-actions { padding: 0 16px 10px; display: flex; flex-wrap: wrap; gap: 8px; }
        .cs-quick-btn {
            font-size: 0.78rem;
            padding: 5px 12px;
            border-radius: 20px;
            border: 1px solid #1a56db;
            background: transparent;
            color: #1a56db;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
        }
        .cs-quick-btn:hover { background: #1a56db; color: #fff; }

        /* Input area */
        .cs-chat-input-area {
            border-top: 1px solid var(--bs-border-color);
            padding: 10px 12px;
            display: flex;
            gap: 8px;
            flex-shrink: 0;
            align-items: center;
            background: var(--bs-body-bg);
        }
        #cs-chat-input {
            flex: 1;
            border: 1px solid var(--bs-border-color);
            border-radius: 20px;
            padding: 8px 14px;
            font-size: 0.83rem;
            background: var(--bs-secondary-bg);
            color: var(--bs-body-color);
            outline: none;
            resize: none;
        }
        #cs-chat-input:focus { border-color: #1a56db; }
        #cs-chat-send {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: #1a56db;
            border: none;
            color: #fff;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            transition: background 0.15s;
        }
        #cs-chat-send:hover { background: #1648c0; }
        .cs-chat-footer { text-align: center; font-size: 0.65rem; color: var(--bs-secondary-color); padding: 6px 0 8px; }

        /* Bouncing Dots Typing Indicator */
        .cs-typing-indicator {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 8px;
        }
        .cs-typing-indicator span {
            width: 6px;
            height: 6px;
            background-color: var(--bs-body-color);
            border-radius: 50%;
            opacity: 0.4;
            animation: csBounce 1.4s infinite both;
        }
        .cs-typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .cs-typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes csBounce {
            0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
            40% { transform: scale(1); opacity: 1; }
        }
        /* Dynamic table styles inside bot chat bubble */
        .cs-chat-table {
            width: 100%;
            font-size: 0.76rem;
            margin-top: 8px;
            border-collapse: collapse;
        }
        .cs-chat-table th, .cs-chat-table td {
            padding: 6px 8px;
            border-bottom: 1px solid var(--bs-border-color);
            text-align: left;
        }
        .cs-chat-table th {
            font-weight: 600;
            background: var(--bs-secondary-bg);
        }

        @@media (max-width: 480px) {
            #cs-chat-panel { width: calc(100vw - 32px); right: 16px; }
            #cs-chat-launcher { bottom: 20px; right: 20px; }
        }
    </style>

    <!-- Launcher button -->
    <button id="cs-chat-launcher" title="Support Chat" onclick="toggleCsChat()">
        <i class="bi bi-chat-dots-fill" id="cs-chat-launcher-icon"></i>
        <span id="cs-chat-badge">1</span>
    </button>

    <!-- Chat panel -->
    <div id="cs-chat-panel">
        <!-- Header -->
        <div class="cs-chat-header">
            <div class="cs-chat-header-info">
                <div class="cs-chat-avatar"><i class="bi bi-headset"></i></div>
                <div>
                    <div class="cs-chat-title">ClientSphere Support</div>
                    <div class="cs-chat-subtitle">We typically reply within 1 business day</div>
                </div>
            </div>
            <button class="cs-chat-close-btn" onclick="toggleCsChat()" title="Close"><i class="bi bi-x-lg"></i></button>
        </div>

        <!-- Messages -->
        <div id="cs-chat-messages">
            <div class="cs-date-label" id="cs-date-label"></div>
            <div class="cs-msg bot">
                <div class="cs-msg-avatar"><i class="bi bi-robot"></i></div>
                <div>
                    <div class="cs-msg-bubble">
                        👋 Hi there! I'm the <strong>ClientSphere Support</strong> assistant. How can I help you today?
                    </div>
                    <div class="cs-msg-time" id="cs-bot-time"></div>
                </div>
            </div>
        </div>

        <!-- Quick action buttons -->
        <div class="cs-quick-actions" id="cs-quick-actions">
            <button class="cs-quick-btn" onclick="csQuickAction('I have an issue with my order')">📦 Order Issue</button>
            <button class="cs-quick-btn" onclick="csQuickAction('I need help with my invoice')">🧾 Invoice Help</button>
            <button class="cs-quick-btn" onclick="csQuickAction('I want to view my support tickets')">🎫 My Tickets</button>
            <button class="cs-quick-btn" onclick="csQuickAction('Other question')">💬 Other</button>
        </div>

        <!-- Input -->
        <div class="cs-chat-input-area">
            <textarea id="cs-chat-input" rows="1" placeholder="Write your message..." onkeydown="csChatKeydown(event)"></textarea>
            <button id="cs-chat-send" onclick="csSendMessage()" title="Send"><i class="bi bi-send-fill"></i></button>
        </div>
        <div class="cs-chat-footer">POWERED BY CLIENTSPHERE</div>
    </div>

    <script>
        // ── Chat state ────────────────────────────────────────────────
        let csChatOpen = false;
        let csChatStep = 'idle'; // idle | awaiting_subject | awaiting_desc
        let csChatSubject = '';

        // Init timestamps
        (function() {
            const now = new Date();
            const dateStr = now.toLocaleDateString('en-PH', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            const timeStr = now.toLocaleTimeString('en-PH', { hour:'2-digit', minute:'2-digit' });
            const dl = document.getElementById('cs-date-label');
            const bt = document.getElementById('cs-bot-time');
            if (dl) dl.textContent = dateStr;
            if (bt) bt.textContent = timeStr;
        })();

        function toggleCsChat() {
            csChatOpen = !csChatOpen;
            const panel = document.getElementById('cs-chat-panel');
            const launcher = document.getElementById('cs-chat-launcher');
            const icon = document.getElementById('cs-chat-launcher-icon');
            const badge = document.getElementById('cs-chat-badge');
            panel.classList.toggle('open', csChatOpen);
            launcher.classList.toggle('open', csChatOpen);
            icon.className = csChatOpen ? 'bi bi-x-lg' : 'bi bi-chat-dots-fill';
            if (csChatOpen && badge) badge.style.display = 'none';
            if (csChatOpen) document.getElementById('cs-chat-input').focus();
        }

        function csAddMsg(text, from) {
            const msgs = document.getElementById('cs-chat-messages');
            const qs = document.getElementById('cs-quick-actions');
            if (qs) qs.style.display = 'none'; // hide quick actions after first reply

            const div = document.createElement('div');
            div.className = `cs-msg ${from}`;
            const now = new Date().toLocaleTimeString('en-PH', { hour:'2-digit', minute:'2-digit' });

            if (from === 'bot') {
                div.innerHTML = `<div class="cs-msg-avatar"><i class="bi bi-robot"></i></div>
                    <div><div class="cs-msg-bubble">${text}</div><div class="cs-msg-time">${now}</div></div>`;
            } else {
                div.innerHTML = `<div><div class="cs-msg-bubble">${text}</div><div class="cs-msg-time text-end">${now}</div></div>`;
            }
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function csShowTypingIndicator() {
            const msgs = document.getElementById('cs-chat-messages');
            const indicator = document.getElementById('cs-typing-indicator');
            if (indicator) return;

            const div = document.createElement('div');
            div.id = 'cs-typing-indicator';
            div.className = 'cs-msg bot';
            div.innerHTML = `
                <div class="cs-msg-avatar"><i class="bi bi-robot"></i></div>
                <div>
                    <div class="cs-msg-bubble">
                        <div class="cs-typing-indicator">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>`;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function csHideTypingIndicator() {
            const indicator = document.getElementById('cs-typing-indicator');
            if (indicator) indicator.remove();
        }

        function csQuickAction(text) {
            csAddMsg(text, 'user');
            csShowTypingIndicator();
            setTimeout(() => csBotRespond(text), 1000);
        }

        function csSendMessage() {
            const inp = document.getElementById('cs-chat-input');
            const text = inp.value.trim();
            if (!text) return;
            inp.value = '';
            csAddMsg(text, 'user');
            csShowTypingIndicator();
            setTimeout(() => csBotRespond(text), 1000);
        }

        function csChatKeydown(e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); csSendMessage(); }
        }

        function csBotRespond(userText) {
            csHideTypingIndicator();
            const lower = userText.toLowerCase().trim();

            if (csChatStep === 'awaiting_subject') {
                csChatSubject = userText;
                csChatStep = 'awaiting_desc';
                csAddMsg('Got it! Now please briefly describe your issue so our team can help you faster.', 'bot');
                return;
            }

            if (csChatStep === 'awaiting_desc') {
                csChatStep = 'submitting';
                csAddMsg('⏳ Submitting your ticket...', 'bot');
                
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                fetch('/CustomerPortal/CreateTicket', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: `subject=${encodeURIComponent(csChatSubject)}&description=${encodeURIComponent(userText)}`
                }).then(r => {
                    if (r.ok || r.redirected) {
                        csAddMsg('✅ Your ticket has been submitted! Our support team will get back to you. You can track it under <a href="/CustomerPortal/MyTickets" class="text-primary fw-semibold">My Tickets</a>.', 'bot');
                    } else {
                        csAddMsg('⚠️ Something went wrong submitting your ticket. Please try visiting <a href="/CustomerPortal/CreateTicket" class="text-primary fw-semibold">Support Tickets</a> directly.', 'bot');
                    }
                    csChatStep = 'done';
                }).catch(() => {
                    csAddMsg('⚠️ Connection error. Please visit <a href="/CustomerPortal/MyTickets" class="text-primary fw-semibold">My Tickets</a> to submit manually.', 'bot');
                    csChatStep = 'done';
                });
                return;
            }

            // Commands & queries
            if (lower.includes('order')) {
                csShowTypingIndicator();
                fetch('/CustomerPortal/GetChatbotSummary')
                    .then(r => r.json())
                    .then(data => {
                        csHideTypingIndicator();
                        if (!data.orders || data.orders.length === 0) {
                            csAddMsg('📦 You don\'t have any orders yet. Visit our portal features or contact support to place your first order!', 'bot');
                        } else {
                            let tableHtml = `Here are your recent orders:<br>
                                <table class="cs-chat-table">
                                    <thead>
                                        <tr><th>ID</th><th>Date</th><th>Status</th><th>Total</th></tr>
                                    </thead>
                                    <tbody>`;
                            data.orders.forEach(o => {
                                let badgeClass = o.status === 'Completed' ? 'text-success' : (o.status === 'Cancelled' ? 'text-danger' : 'text-warning');
                                tableHtml += `<tr>
                                    <td>#${o.id}</td>
                                    <td>${o.orderDate}</td>
                                    <td><strong class="${badgeClass}">${o.status}</strong></td>
                                    <td>$${o.totalAmount.toFixed(2)}</td>
                                </tr>`;
                            });
                            tableHtml += `</tbody></table><br>Go to <a href="/CustomerPortal/MyOrders" class="text-primary fw-semibold">My Orders →</a> for more details.`;
                            csAddMsg(tableHtml, 'bot');
                        }
                    })
                    .catch(() => {
                        csHideTypingIndicator();
                        csAddMsg('⚠️ Failed to fetch your orders. Please check <a href="/CustomerPortal/MyOrders" class="text-primary fw-semibold">My Orders</a> directly.', 'bot');
                    });
            } else if (lower.includes('invoice') || lower.includes('billing') || lower.includes('payment')) {
                csShowTypingIndicator();
                fetch('/CustomerPortal/GetChatbotSummary')
                    .then(r => r.json())
                    .then(data => {
                        csHideTypingIndicator();
                        if (!data.invoices || data.invoices.length === 0) {
                            csAddMsg('🧾 You don\'t have any invoices on record.', 'bot');
                        } else {
                            let tableHtml = `Here are your recent invoices:<br>
                                <table class="cs-chat-table">
                                    <thead>
                                        <tr><th>ID</th><th>Date</th><th>Status</th><th>Amount</th></tr>
                                    </thead>
                                    <tbody>`;
                            data.invoices.forEach(i => {
                                let badgeClass = i.status === 'Paid' ? 'text-success' : (i.status === 'Cancelled' ? 'text-danger' : 'text-warning');
                                tableHtml += `<tr>
                                    <td>#${i.id}</td>
                                    <td>${i.issueDate}</td>
                                    <td><strong class="${badgeClass}">${i.status}</strong></td>
                                    <td>$${i.totalAmount.toFixed(2)}</td>
                                </tr>`;
                            });
                            tableHtml += `</tbody></table><br>Manage payments in <a href="/CustomerPortal/MyInvoices" class="text-primary fw-semibold">Invoices →</a>.`;
                            csAddMsg(tableHtml, 'bot');
                        }
                    })
                    .catch(() => {
                        csHideTypingIndicator();
                        csAddMsg('⚠️ Failed to fetch your billing summary. Please view <a href="/CustomerPortal/MyInvoices" class="text-primary fw-semibold">Invoices</a>.', 'bot');
                    });
            } else if (lower.includes('ticket') || lower.includes('support')) {
                csShowTypingIndicator();
                fetch('/CustomerPortal/GetChatbotSummary')
                    .then(r => r.json())
                    .then(data => {
                        csHideTypingIndicator();
                        if (!data.tickets || data.tickets.length === 0) {
                            csAddMsg('🎫 You have no support tickets. Type <strong>"create ticket"</strong> to create one now!', 'bot');
                        } else {
                            let listHtml = `Here are your recent support tickets:<br>
                                <table class="cs-chat-table">
                                    <thead>
                                        <tr><th>Subject</th><th>Status</th><th>Priority</th></tr>
                                    </thead>
                                    <tbody>`;
                            data.tickets.forEach(t => {
                                let badgeClass = t.status === 'Open' ? 'text-primary' : (t.status === 'Closed' || t.status === 'Resolved' ? 'text-success' : 'text-warning');
                                listHtml += `<tr>
                                    <td>${t.subject}</td>
                                    <td><strong class="${badgeClass}">${t.status}</strong></td>
                                    <td>${t.priority}</td>
                                </tr>`;
                            });
                            listHtml += `</tbody></table><br>Manage tickets at <a href="/CustomerPortal/MyTickets" class="text-primary fw-semibold">Support Tickets →</a>.`;
                            csAddMsg(listHtml, 'bot');
                        }
                    })
                    .catch(() => {
                        csHideTypingIndicator();
                        csAddMsg('⚠️ Failed to load your tickets. Please open <a href="/CustomerPortal/MyTickets" class="text-primary fw-semibold">Support Tickets</a> directly.', 'bot');
                    });
            } else if (lower === 'yes' || lower === 'yes please' || lower === 'sure') {
                csChatStep = 'awaiting_subject';
                csAddMsg('Sure! Let\'s create a ticket for you. First, what is the <strong>subject</strong> of your issue? (e.g. "Incorrect invoice amount")', 'bot');
            } else if (lower.includes('create') || lower.includes('submit') || lower.includes('new ticket') || lower.includes('issue') || lower.includes('problem')) {
                csChatStep = 'awaiting_subject';
                csAddMsg('I\'ll help you create a support ticket! What is the <strong>subject</strong> of your issue?', 'bot');
            } else if (lower.includes('security') || lower.includes('rules') || lower.includes('policy')) {
                csAddMsg('You can review our system guidelines, rules and security compliance details on our official <a href="/Home/SecurityPolicy" class="text-primary fw-semibold" target="_blank">Trust Center & Security Policy page</a>.', 'bot');
            } else if (lower.includes('hello') || lower.includes('hi') || lower.includes('hey') || lower.includes('help') || lower.includes('menu')) {
                csAddMsg(`👋 Hello! I am your interactive assistant. Here is what I can do for you:<br><br>
                    • 📦 <strong>Orders</strong>: Ask me to "Show my orders"<br>
                    • 🧾 <strong>Billing</strong>: Ask me to "Show my invoices"<br>
                    • 🎫 <strong>Tickets</strong>: Ask me to "Show my tickets"<br>
                    • ➕ <strong>Support</strong>: Type "create ticket" to launch the support wizard<br>
                    • 🛡️ <strong>Rules</strong>: Ask me about "security policy"<br><br>
                    What can I help you with?`, 'bot');
            } else {
                csAddMsg('I\'m here to help! You can:<br>• Create a support ticket<br>• View existing tickets<br>• Check your orders or invoices<br>• Check our security policies<br><br>Type your question or click one of the quick options. A human agent will follow up on any tickets submitted.', 'bot');
            }
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" integrity="sha512-7eHRwcbYkK4d9g/6tD/mhkf++eoTHwpNM9woBxtPUBWm67zeAfFC+HrdoE2GanKeocly/VxeLvIqwvCdk7qScg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" integrity="sha512-onMTRKJBKz8M1TnqqDuGBlowlH0ohFzMXYRNebz+yOcc5Tq/l4503043K4bOowXhDgwH5mGqZk1zEte6xHqYww==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/confirm.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarToggle, #sidebarOverlay').on('click', function () {
                $('#customerSidebar').toggleClass('active');
                $('#sidebarOverlay').toggleClass('active');
            });
        });

        // Live clock
        function updateCustomerClock() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
            const el = document.getElementById('customerDateTime');
            if (el) el.textContent = now.toLocaleString('en-PH', options);
        }
        setInterval(updateCustomerClock, 1000);
        updateCustomerClock();

        // Dark mode
        function toggleCustomerDarkMode() {
            const html = document.getElementById('htmlRoot');
            const isDark = html.getAttribute('data-bs-theme') === 'dark';
            html.setAttribute('data-bs-theme', isDark ? 'light' : 'dark');
            localStorage.setItem('clientsphere-theme', isDark ? 'light' : 'dark');
            document.getElementById('darkModeIcon').className = isDark ? 'bi bi-moon-stars' : 'bi bi-sun';
        }

        // Set initial icon and load notifications
        (function() {
            const saved = localStorage.getItem('clientsphere-theme');
            if (saved === 'dark') {
                const icon = document.getElementById('darkModeIcon');
                if (icon) icon.className = 'bi bi-sun';
            }
            loadNotifications();
            setInterval(loadNotifications, 60000);
        })();

        // Notifications logic
        function loadNotifications() {
            fetch('/Notifications/GetUnread')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('notifBadge');
                    const list = document.getElementById('notifList');
                    const empty = document.getElementById('notifEmpty');
                    if (!badge || !list) return;

                    if (data.count > 0) {
                        badge.textContent = data.count > 9 ? '9+' : data.count;
                        badge.style.display = '';
                    } else {
                        badge.style.display = 'none';
                    }

                    // Remove old items (keep header + empty)
                    const oldItems = list.querySelectorAll('.notif-item');
                    oldItems.forEach(el => el.remove());

                    if (data.items && data.items.length > 0) {
                        if (empty) empty.style.display = 'none';
                        data.items.forEach(n => {
                            const li = document.createElement('li');
                            li.className = 'notif-item border-bottom';
                            li.innerHTML = `<a href="${n.url || '#'}" class="dropdown-item py-2 text-wrap" onclick="markRead(${n.id}, this)">
                                <div class="fw-semibold small">${n.title}</div>
                                <div class="small text-muted">${n.message}</div>
                                <div class="text-muted" style="font-size:0.72rem;">${n.timeAgo}</div>
                            </a>`;
                            list.appendChild(li);
                        });
                    } else {
                        if (empty) empty.style.display = '';
                    }
                })
                .catch(() => {});
        }

        function markRead(id, el) {
            fetch(`/Notifications/MarkRead/${id}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' } })
                .then(() => loadNotifications());
        }

        function markAllRead() {
            fetch('/Notifications/MarkAllRead', { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' } })
                .then(() => loadNotifications());
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
