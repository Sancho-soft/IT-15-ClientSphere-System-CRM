<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClientSphere Customer Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script>
        (function () {
            const saved = localStorage.getItem('clientsphere-theme');
            if (saved === 'dark') document.documentElement.setAttribute('data-bs-theme', 'dark');
        })();
    </script>
    <style>
        body {
            background-color: var(--bs-body-bg);
            color: var(--bs-body-color);
        }
        .customer-sidebar {
            width: 260px;
            height: 100vh;
            background-color: var(--bs-body-bg);
            border-right: 1px solid var(--bs-border-color);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .main-content { margin-left: 260px; padding: 2rem; }
        .nav-link { color: var(--bs-body-color); font-weight: 500; padding: 0.8rem 1.5rem; display: flex; align-items: center; }
        .nav-link:hover, .nav-link.active { color: #0d6efd; background-color: var(--bs-primary-bg-subtle); border-right: 3px solid #0d6efd; }
        .nav-link i { font-size: 1.2rem; margin-right: 0.8rem; }
        
        @@media (max-width: 768px) {
            .customer-sidebar { left: -260px; transition: 0.3s; }
            .customer-sidebar.active { left: 0; }
            .main-content { margin-left: 0; }
            .sidebar-overlay { display: none; position: fixed; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 999; top: 0; left: 0; }
            .sidebar-overlay.active { display: block; }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div id="customerSidebar" class="customer-sidebar">
        <div class="flex-grow-1 overflow-auto">
            <div class="p-4">
                <a href="/" class="d-block mb-2 text-center">
                    <img src="~/images/logocustomer.png" alt="ClientSphere" style="max-height: 150px; width: auto; max-width: 100%;" class="img-fluid">
                </a>
                <div class="small text-uppercase text-muted fw-bold mt-3 mb-2" style="letter-spacing: 1px;">Customer Portal</div>
            </div>

            <nav class="nav flex-column mb-3">
                <a class="nav-link @(ViewData["CurrentPage"] as string == "Dashboard" ? "active" : "")" asp-controller="CustomerPortal" asp-action="Dashboard">
                    <i class="bi bi-grid-fill"></i> Overview
                </a>
                <a class="nav-link" asp-controller="CustomerPortal" asp-action="MyOrders">
                    <i class="bi bi-box-seam"></i> My Orders
                </a>
                <a class="nav-link" asp-controller="CustomerPortal" asp-action="MyInvoices">
                    <i class="bi bi-receipt"></i> Invoices
                </a>
                <a class="nav-link" asp-controller="CustomerPortal" asp-action="MyTickets">
                    <i class="bi bi-ticket-perforated"></i> Support Tickets
                </a>
            </nav>
        </div>

    </div>

    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- Main Content -->
    <div class="main-content">
        <header class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <div class="d-flex align-items-center">
                <button id="sidebarToggle" class="btn btn-outline-secondary d-md-none me-3">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    @{
                        var ctxUser = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Identity.UserManager<ClientSphere.Models.ApplicationUser>)) as Microsoft.AspNetCore.Identity.UserManager<ClientSphere.Models.ApplicationUser>;
                        var ctxAppUser = ctxUser != null ? await ctxUser.GetUserAsync(User) : null;
                        var ctxFirstName = ctxAppUser?.FirstName ?? User.Identity?.Name?.Split('@')[0] ?? "Customer";
                    }
                    <h5 class="mb-0 fw-bold">Welcome back, @ctxFirstName</h5>
                    <div class="text-muted small">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle me-2 px-2 py-1">Customer</span>
                        <i class="bi bi-calendar3 me-1"></i> <span id="customerDateTime">@DateTime.Now.ToString("dddd, MMMM d, yyyy - hh:mm tt")</span>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button id="darkModeToggleBtn" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Toggle Dark Mode" onclick="toggleCustomerDarkMode()">
                    <i id="darkModeIcon" class="bi bi-moon-stars"></i>
                </button>
                <!-- Notification Bell -->
                <div class="dropdown" id="notifDropdown">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill position-relative px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" id="notifBellBtn">
                        <i class="bi bi-bell"></i>
                        <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;display:none;">0</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1 p-0" style="min-width:320px;max-height:400px;overflow-y:auto;" id="notifList">
                        <li class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <span class="fw-semibold small">Notifications</span>
                            <button class="btn btn-link btn-sm text-muted p-0 text-decoration-none" onclick="markAllRead()" style="font-size:0.78rem;">Mark all read</button>
                        </li>
                        <li id="notifEmpty" class="text-center text-muted py-4 small">No new notifications</li>
                    </ul>
                </div>
                <a asp-controller="CustomerPortal" asp-action="CreateTicket" class="btn btn-primary rounded-pill d-none d-md-inline-block">
                    <i class="bi bi-plus-lg me-1"></i> New Ticket
                </a>
                
                @{
                    var drpFullName = ctxAppUser != null && !string.IsNullOrWhiteSpace(ctxAppUser?.FirstName) ? $"{ctxAppUser.FirstName} {ctxAppUser.LastName}" : User.Identity?.Name;
                    var drpEmail = ctxAppUser?.Email ?? User.Identity?.Name;
                    var drpInitials = ctxAppUser != null && !string.IsNullOrWhiteSpace(ctxAppUser?.FirstName) 
                        ? $"{ctxAppUser.FirstName.Substring(0, 1).ToUpper()}{(string.IsNullOrWhiteSpace(ctxAppUser.LastName) ? "" : ctxAppUser.LastName.Substring(0, 1).ToUpper())}" 
                        : (User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "C");
                }
                
                <div class="dropdown">
                    <button class="btn btn-sm d-flex align-items-center gap-2 border rounded-pill px-3 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="max-width: 210px;">
                        @if (ctxAppUser != null && !string.IsNullOrEmpty(ctxAppUser.ProfilePictureUrl))
                        {
                            <img src="@ctxAppUser.ProfilePictureUrl" alt="Profile" class="rounded-circle" style="width: 28px; height: 28px; object-fit: cover; flex-shrink: 0;">
                        }
                        else
                        {
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem; flex-shrink: 0;">@drpInitials</div>
                        }
                        <div class="text-start overflow-hidden d-none d-md-block">
                            <div class="fw-semibold text-truncate" style="font-size: 0.82rem; line-height: 1.2;">@drpFullName</div>
                            <div class="text-muted text-truncate" style="font-size: 0.72rem;">Customer</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1" style="min-width: 200px;">
                        <li>
                            <div class="px-3 py-2 border-bottom">
                                <div class="fw-bold" style="font-size: 0.88rem;">@drpFullName</div>
                                <div class="text-muted" style="font-size: 0.78rem;">@drpEmail</div>
                            </div>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="CustomerPortal" asp-action="MyProfile">
                                <i class="bi bi-person-circle text-primary"></i> Profile Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="px-2 pb-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarToggle, #sidebarOverlay').on('click', function () {
                $('#customerSidebar').toggleClass('active');
                $('#sidebarOverlay').toggleClass('active');
            });
        });

        // Live clock
        function updateCustomerClock() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
            const el = document.getElementById('customerDateTime');
            if (el) el.textContent = now.toLocaleString('en-PH', options);
        }
        setInterval(updateCustomerClock, 1000);
        updateCustomerClock();

        // Dark mode
        function toggleCustomerDarkMode() {
            const html = document.getElementById('htmlRoot');
            const isDark = html.getAttribute('data-bs-theme') === 'dark';
            html.setAttribute('data-bs-theme', isDark ? 'light' : 'dark');
            localStorage.setItem('clientsphere-theme', isDark ? 'light' : 'dark');
            document.getElementById('darkModeIcon').className = isDark ? 'bi bi-moon-stars' : 'bi bi-sun';
        }

        // Set initial icon and load notifications
        (function() {
            const saved = localStorage.getItem('clientsphere-theme');
            if (saved === 'dark') {
                const icon = document.getElementById('darkModeIcon');
                if (icon) icon.className = 'bi bi-sun';
            }
            loadNotifications();
            setInterval(loadNotifications, 60000);
        })();

        // Notifications logic
        function loadNotifications() {
            fetch('/Notifications/GetUnread')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('notifBadge');
                    const list = document.getElementById('notifList');
                    const empty = document.getElementById('notifEmpty');
                    if (!badge || !list) return;

                    if (data.count > 0) {
                        badge.textContent = data.count > 9 ? '9+' : data.count;
                        badge.style.display = '';
                    } else {
                        badge.style.display = 'none';
                    }

                    // Remove old items (keep header + empty)
                    const oldItems = list.querySelectorAll('.notif-item');
                    oldItems.forEach(el => el.remove());

                    if (data.items && data.items.length > 0) {
                        if (empty) empty.style.display = 'none';
                        data.items.forEach(n => {
                            const li = document.createElement('li');
                            li.className = 'notif-item border-bottom';
                            li.innerHTML = `<a href="${n.url || '#'}" class="dropdown-item py-2 text-wrap" onclick="markRead(${n.id}, this)">
                                <div class="fw-semibold small">${n.title}</div>
                                <div class="small text-muted">${n.message}</div>
                                <div class="text-muted" style="font-size:0.72rem;">${n.timeAgo}</div>
                            </a>`;
                            list.appendChild(li);
                        });
                    } else {
                        if (empty) empty.style.display = '';
                    }
                })
                .catch(() => {});
        }

        function markRead(id, el) {
            fetch(`/Notifications/MarkRead/${id}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' } })
                .then(() => loadNotifications());
        }

        function markAllRead() {
            fetch('/Notifications/MarkAllRead', { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' } })
                .then(() => loadNotifications());
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
