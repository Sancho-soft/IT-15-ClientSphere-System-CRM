@model IEnumerable<ClientSphere.Models.Campaign>

<div class="p-3 bg-transparent border-bottom text-center rounded-top">
    <h6 class="mb-0 fw-bold"><i class="bi bi-broadcast text-danger me-2"></i>Active Initiatives</h6>
</div>
<div class="list-group list-group-flush rounded-bottom">
    @if (Model != null && Model.Any())
    {
        foreach (var campaign in Model)
        {
            <div class="list-group-item p-3 list-group-item-action border-bottom">
                <div class="d-flex w-100 justify-content-between mb-1">
                    <h6 class="mb-1 fw-bold text-truncate" style="max-width: 200px;" title="@campaign.Name">@campaign.Name</h6>
                    <small class="text-success fw-bold">&#8369;@campaign.ExpectedRevenue.ToString("N0")</small>
                </div>
                <p class="mb-1 small text-muted text-truncate" style="max-width: 280px;" title="@campaign.Description">
                    @(string.IsNullOrEmpty(campaign.Description) ? "Join our latest initiative! Details driving the new community offers." : campaign.Description)
                </p>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-primary"><i class="bi @(campaign.Type == "Email" ? "bi-envelope" : campaign.Type == "Social Media" ? "bi-share" : "bi-megaphone") me-1"></i>@campaign.Type</small>
                    <small class="text-muted"><i class="bi bi-people me-1"></i>@campaign.TargetAudienceSize Target</small>
                </div>
            </div>
        }
    }
    else
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
            <small>No active campaigns right now.</small>
        </div>
    }
</div>
