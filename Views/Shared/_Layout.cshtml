@using Microsoft.AspNetCore.Identity
@using ClientSphere.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClientSphere</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .navbar-brand { font-weight: 700; color: #0d6efd !important; font-size: 1.5rem; }
        .nav-link { font-weight: 500; }
        .btn-primary { background-color: #0d6efd; border-color: #0d6efd; }
        .btn-primary:hover { background-color: #0b5ed7; border-color: #0a58ca; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top shadow-sm gsap-fade-in" style="z-index: 1030;">
        <nav class="navbar navbar-expand-lg navbar-toggleable-lg navbar-light py-2">
            <div class="container d-flex align-items-center">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index" style="margin-right: 2rem;">
                    <img src="~/images/logolanding.png" alt="ClientSphere" style="height: 120px; width: auto; margin: -40px 0; object-fit: contain;" class="d-inline-block align-middle">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <!-- Public Menu -->
                        <li class="nav-item dropdown me-2 d-flex align-items-center">
                            <span class="position-absolute translate-middle p-1 bg-danger border border-light rounded-circle live-pulse" style="left: 10px; top: 50%; z-index: 10;">
                                <span class="visually-hidden">Live</span>
                            </span>
                            <a class="nav-link dropdown-toggle fw-bold text-danger position-relative ms-2" href="#" id="campaignsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                                Live Campaigns
                            </a>
                            <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0" aria-labelledby="campaignsDropdown" style="width: 380px; max-height: 500px; overflow-y: auto;">
                                @await Component.InvokeAsync("ActiveCampaigns")
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="featuresDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Features
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="featuresDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#features-crm">CRM Tools</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#features-sales">Sales Tracking</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#features-marketing">Marketing Automation</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="solutionsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Solutions
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="solutionsDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#solutions-smb">Small Business</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#solutions-enterprise">Enterprise</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="aboutDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                About
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="aboutDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#about">Our Story</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#about">Team</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#about">Careers</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Url.Action("Index", "Home")#contact">Contact</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid p-0 flex-grow-1 gsap-slide-up">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 pb-4 mt-auto gsap-slide-up">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5 class="text-uppercase mb-4 fw-bold text-primary">ClientSphere</h5>
                    <p class="small text-white-50 mb-4">
                        Empowering businesses with a friendly, comprehensive customer relationship management solution.
                    </p>
                    <div class="d-flex">
                        <a href="#" class="text-white me-3"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white me-3"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-white me-3"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5 class="text-uppercase mb-4 fw-bold">Product</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none slide-hover">CRM Tools</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none slide-hover">Sales Tracking</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none slide-hover">Marketing</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none slide-hover">Billing</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5 class="text-uppercase mb-4 fw-bold">Company</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none slide-hover">About Us</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none slide-hover">Careers</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none slide-hover">Blog</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none slide-hover">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5 class="text-uppercase mb-4 fw-bold">Newsletter</h5>
                    <p class="small text-white-50 mb-4">Subscribe to our newsletter for the latest updates.</p>
                    <form action="#">
                        <div class="input-group">
                            <input type="email" class="form-control" placeholder="Email address" aria-label="Email address">
                            <button class="btn btn-primary" type="button"><i class="bi bi-send"></i></button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-4 text-center text-white-50 small">
                &copy; 2026 ClientSphere. All rights reserved. <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-light text-decoration-none ms-2">Privacy Policy</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" integrity="sha512-7eHRwcbYkK4d9g/6tD/mhkf++eoTHwpNM9woBxtPUBWm67zeAfFC+HrdoE2GanKeocly/VxeLvIqwvCdk7qScg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" integrity="sha512-onMTRKJBKz8M1TnqqDuGBlowlH0ohFzMXYRNebz+yOcc5Tq/l4503043K4bOowXhDgwH5mGqZk1zEte6xHqYww==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ===== ClientSphere Floating Support Chat Widget ===== -->
    <style>
        #cs-chat-launcher {
            position: fixed; bottom: 28px; right: 28px; z-index: 9999;
            width: 58px; height: 58px; border-radius: 50%;
            background: #1a56db; border: none; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 20px rgba(26,86,219,0.45);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        #cs-chat-launcher:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(26,86,219,0.6); }
        #cs-chat-launcher i { color: #fff; font-size: 1.4rem; transition: transform 0.3s ease; }
        #cs-chat-launcher.open i { transform: rotate(45deg); }
        #cs-chat-panel {
            position: fixed; bottom: 100px; right: 28px; z-index: 9998;
            width: 360px; max-height: 540px; border-radius: 16px;
            background: #fff; box-shadow: 0 12px 48px rgba(0,0,0,0.18);
            display: flex; flex-direction: column; overflow: hidden;
            transform: translateY(20px) scale(0.97); opacity: 0;
            pointer-events: none; transition: transform 0.25s ease, opacity 0.25s ease;
        }
        #cs-chat-panel.open { transform: translateY(0) scale(1); opacity: 1; pointer-events: all; }
        .cs-chat-header { background: #1a56db; color: #fff; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
        .cs-chat-header-info { display: flex; align-items: center; gap: 10px; }
        .cs-chat-avatar { width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
        .cs-chat-title { font-weight: 700; font-size: 0.95rem; }
        .cs-chat-subtitle { font-size: 0.72rem; opacity: 0.85; }
        .cs-chat-close-btn { background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; opacity: 0.85; padding: 4px; border-radius: 50%; transition: background 0.15s; }
        .cs-chat-close-btn:hover { background: rgba(255,255,255,0.2); opacity: 1; }
        #cs-chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; background: #f8faff; }
        .cs-date-label { text-align: center; font-size: 0.7rem; color: #6b7280; background: #e5e7eb; border-radius: 20px; padding: 3px 12px; align-self: center; }
        .cs-msg { display: flex; gap: 8px; max-width: 90%; }
        .cs-msg.bot { align-self: flex-start; }
        .cs-msg.user { align-self: flex-end; flex-direction: row-reverse; }
        .cs-msg-avatar { width: 30px; height: 30px; min-width: 30px; border-radius: 50%; background: #1a56db; color: #fff; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; }
        .cs-msg-bubble { padding: 10px 13px; border-radius: 14px; font-size: 0.83rem; line-height: 1.5; }
        .cs-msg.bot .cs-msg-bubble { background: #fff; color: #111827; border-bottom-left-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); }
        .cs-msg.user .cs-msg-bubble { background: #1a56db; color: #fff; border-bottom-right-radius: 4px; }
        .cs-msg-time { font-size: 0.68rem; opacity: 0.5; margin-top: 4px; }
        .cs-quick-actions { padding: 0 16px 10px; display: flex; flex-wrap: wrap; gap: 8px; background: #f8faff; }
        .cs-quick-btn { font-size: 0.78rem; padding: 5px 12px; border-radius: 20px; border: 1px solid #1a56db; background: transparent; color: #1a56db; cursor: pointer; transition: background 0.15s, color 0.15s; }
        .cs-quick-btn:hover { background: #1a56db; color: #fff; }
        .cs-chat-input-area { border-top: 1px solid #e5e7eb; padding: 10px 12px; display: flex; gap: 8px; flex-shrink: 0; align-items: center; background: #fff; }
        #cs-chat-input { flex: 1; border: 1px solid #e5e7eb; border-radius: 20px; padding: 8px 14px; font-size: 0.83rem; background: #f3f4f6; color: #111; outline: none; resize: none; }
        #cs-chat-input:focus { border-color: #1a56db; }
        #cs-chat-send { width: 36px; height: 36px; border-radius: 50%; background: #1a56db; border: none; color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.15s; }
        #cs-chat-send:hover { background: #1648c0; }
        .cs-chat-footer { text-align: center; font-size: 0.65rem; color: #9ca3af; padding: 6px 0 8px; background: #fff; }
        @@media (max-width: 480px) { #cs-chat-panel { width: calc(100vw - 32px); right: 16px; } #cs-chat-launcher { bottom: 20px; right: 20px; } }
    </style>

    <button id="cs-chat-launcher" title="Support Chat" onclick="toggleCsChat()">
        <i class="bi bi-chat-dots-fill" id="cs-chat-launcher-icon"></i>
    </button>

    <div id="cs-chat-panel">
        <div class="cs-chat-header">
            <div class="cs-chat-header-info">
                <div class="cs-chat-avatar"><i class="bi bi-headset"></i></div>
                <div>
                    <div class="cs-chat-title">ClientSphere Support</div>
                    <div class="cs-chat-subtitle">We typically reply within 1 business day</div>
                </div>
            </div>
            <button class="cs-chat-close-btn" onclick="toggleCsChat()"><i class="bi bi-x-lg"></i></button>
        </div>

        <div id="cs-chat-messages">
            <div class="cs-date-label" id="cs-date-label"></div>
            <div class="cs-msg bot">
                <div class="cs-msg-avatar"><i class="bi bi-robot"></i></div>
                <div>
                    <div class="cs-msg-bubble">👋 Hi! I'm the <strong>ClientSphere</strong> support assistant. How can I help you today?</div>
                    <div class="cs-msg-time" id="cs-bot-time"></div>
                </div>
            </div>
        </div>

        <div class="cs-quick-actions" id="cs-quick-actions">
            <button class="cs-quick-btn" onclick="csQuickAction('Tell me about ClientSphere')">ℹ️ About</button>
            <button class="cs-quick-btn" onclick="csQuickAction('I need technical support')">🛠️ Tech Support</button>
            <button class="cs-quick-btn" onclick="csQuickAction('How do I sign up?')">📝 Sign Up</button>
            <button class="cs-quick-btn" onclick="csQuickAction('I want to contact sales')">📞 Sales</button>
        </div>

        <div class="cs-chat-input-area">
            <textarea id="cs-chat-input" rows="1" placeholder="Write your message..." onkeydown="csChatKeydown(event)"></textarea>
            <button id="cs-chat-send" onclick="csSendMessage()"><i class="bi bi-send-fill"></i></button>
        </div>
        <div class="cs-chat-footer">POWERED BY CLIENTSPHERE</div>
    </div>

    <script>
        let csChatOpen = false;
        (function() {
            const now = new Date();
            const dl = document.getElementById('cs-date-label');
            const bt = document.getElementById('cs-bot-time');
            if (dl) dl.textContent = now.toLocaleDateString('en-PH', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            if (bt) bt.textContent = now.toLocaleTimeString('en-PH', { hour:'2-digit', minute:'2-digit' });
        })();

        function toggleCsChat() {
            csChatOpen = !csChatOpen;
            document.getElementById('cs-chat-panel').classList.toggle('open', csChatOpen);
            document.getElementById('cs-chat-launcher').classList.toggle('open', csChatOpen);
            document.getElementById('cs-chat-launcher-icon').className = csChatOpen ? 'bi bi-x-lg' : 'bi bi-chat-dots-fill';
            if (csChatOpen) document.getElementById('cs-chat-input').focus();
        }

        function csAddMsg(text, from) {
            const msgs = document.getElementById('cs-chat-messages');
            const qs = document.getElementById('cs-quick-actions');
            if (qs) qs.style.display = 'none';
            const div = document.createElement('div');
            div.className = `cs-msg ${from}`;
            const now = new Date().toLocaleTimeString('en-PH', { hour:'2-digit', minute:'2-digit' });
            if (from === 'bot') {
                div.innerHTML = `<div class="cs-msg-avatar"><i class="bi bi-robot"></i></div><div><div class="cs-msg-bubble">${text}</div><div class="cs-msg-time">${now}</div></div>`;
            } else {
                div.innerHTML = `<div><div class="cs-msg-bubble">${text}</div><div class="cs-msg-time text-end">${now}</div></div>`;
            }
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function csQuickAction(text) { csAddMsg(text, 'user'); setTimeout(() => csBotRespond(text), 500); }
        function csSendMessage() {
            const inp = document.getElementById('cs-chat-input');
            const text = inp.value.trim();
            if (!text) return;
            inp.value = '';
            csAddMsg(text, 'user');
            setTimeout(() => csBotRespond(text), 500);
        }
        function csChatKeydown(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); csSendMessage(); } }

        function csBotRespond(userText) {
            const lower = userText.toLowerCase();
            if (lower.includes('about') || lower.includes('clientsphere') || lower.includes('what is')) {
                csAddMsg('ClientSphere is a full-featured CRM platform built for managing customers, leads, sales, marketing campaigns, and support — all in one place. <a href="@Url.Action("Index","Home")#features-crm" class="text-primary fw-semibold">See Features →</a>', 'bot');
            } else if (lower.includes('sign up') || lower.includes('register') || lower.includes('account')) {
                csAddMsg('You can create a customer account here: <a href="/Identity/Account/Register" class="text-primary fw-semibold">Register Now →</a>', 'bot');
            } else if (lower.includes('login') || lower.includes('log in') || lower.includes('sign in')) {
                csAddMsg('You can log in to your account here: <a href="/Identity/Account/Login" class="text-primary fw-semibold">Sign In →</a>', 'bot');
            } else if (lower.includes('sales') || lower.includes('pricing') || lower.includes('plan')) {
                csAddMsg('For sales enquiries, please email us at <a href="mailto:sales@clientsphere.com" class="text-primary fw-semibold">sales@clientsphere.com</a> and our team will get back to you shortly.', 'bot');
            } else if (lower.includes('support') || lower.includes('help') || lower.includes('issue') || lower.includes('problem') || lower.includes('technical')) {
                csAddMsg('For technical support, please <a href="/Identity/Account/Login" class="text-primary fw-semibold">log in</a> to your account and submit a support ticket, or email us at <a href="mailto:support@clientsphere.com" class="text-primary fw-semibold">support@clientsphere.com</a>.', 'bot');
            } else if (lower.includes('feature') || lower.includes('crm') || lower.includes('marketing') || lower.includes('campaign')) {
                csAddMsg('ClientSphere offers CRM tools, sales tracking, marketing automation, invoicing, and customer support — all in one platform. <a href="@Url.Action("Index","Home")#features-crm" class="text-primary fw-semibold">Learn more →</a>', 'bot');
            } else {
                csAddMsg('Thanks for reaching out! For general questions, email us at <a href="mailto:hello@clientsphere.com" class="text-primary fw-semibold">hello@clientsphere.com</a>.<br><br>If you already have an account, <a href="/Identity/Account/Login" class="text-primary fw-semibold">log in here</a> to submit a support ticket.', 'bot');
            }
        }
    </script>
</body>
</html>
