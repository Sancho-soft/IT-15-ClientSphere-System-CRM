@using Microsoft.AspNetCore.Identity
@using ClientSphere.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var navUser = await UserManager.GetUserAsync(User);
    var navFullName = navUser != null && !string.IsNullOrWhiteSpace(navUser.FirstName) ? $"{navUser.FirstName} {navUser.LastName}" : User.Identity?.Name;
    var navEmail = navUser?.Email ?? User.Identity?.Name;
    var navRoles = navUser != null ? await UserManager.GetRolesAsync(navUser) : new List<string>();
    var navRole = navRoles.FirstOrDefault() ?? "User";

    <li class="nav-item">
        @if (User.IsInRole("Admin") || User.IsInRole("Super Admin"))
        {
            <a class="btn btn-primary btn-sm px-3 fw-bold me-2 text-white" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
        }
        else if (User.IsInRole("Sales Manager"))
        {
            <a class="btn btn-primary btn-sm px-3 fw-bold me-2 text-white" asp-controller="SalesManager" asp-action="Dashboard">Dashboard</a>
        }
        else if (User.IsInRole("Sales Staff"))
        {
            <a class="btn btn-primary btn-sm px-3 fw-bold me-2 text-white" asp-controller="SalesStaff" asp-action="Dashboard">Dashboard</a>
        }
        else if (User.IsInRole("Support Staff"))
        {
            <a class="btn btn-primary btn-sm px-3 fw-bold me-2 text-white" asp-controller="SupportStaff" asp-action="Dashboard">Dashboard</a>
        }
        else if (User.IsInRole("Marketing Staff") || User.IsInRole("Marketing Manager"))
        {
             <a class="btn btn-primary btn-sm px-3 fw-bold me-2 text-white" asp-controller="MarketingStaff" asp-action="Dashboard">Dashboard</a>
        }
        else if (User.IsInRole("Billing Staff"))
        {
             <a class="btn btn-primary btn-sm px-3 fw-bold me-2 text-white" asp-controller="Billing" asp-action="Index">Dashboard</a>
        }
         else if (User.IsInRole("Customer"))
        {
             <a class="btn btn-primary btn-sm px-3 fw-bold me-2 text-white" asp-controller="CustomerPortal" asp-action="Dashboard">Portal</a>
        }
    </li>
    <li class="nav-item dropdown">
        <button class="btn btn-sm d-flex align-items-center gap-2 border rounded-pill px-3 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="max-width: 210px;">
            @if (navUser != null && !string.IsNullOrEmpty(navUser.ProfilePictureUrl))
            {
                <img src="@navUser.ProfilePictureUrl" alt="Profile" class="rounded-circle" style="width: 28px; height: 28px; object-fit: cover; flex-shrink: 0;">
            }
            else
            {
                <div class="text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.9rem; flex-shrink: 0; background-color: #ff6b35 !important;">
                    <i class="bi bi-person-fill"></i>
                </div>
            }
            <div class="text-start overflow-hidden d-none d-md-block">
                <div class="fw-semibold text-truncate text-dark" style="font-size: 0.82rem; line-height: 1.2;">@navFullName</div>
                <div class="text-muted text-truncate" style="font-size: 0.72rem;">@navRole</div>
            </div>
            <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1" style="min-width: 200px;">
            <li>
                <div class="px-3 py-2 border-bottom">
                    <div class="fw-bold" style="font-size: 0.88rem;">@navFullName</div>
                    <div class="text-muted" style="font-size: 0.78rem;">@navEmail</div>
                </div>
            </li>
            <li>
                @if (User.IsInRole("Customer"))
                {
                    <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="CustomerPortal" asp-action="MyProfile">
                        <i class="bi bi-person-circle text-primary"></i> Profile Settings
                    </a>
                }
                else
                {
                    <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-circle text-primary"></i> Profile Settings
                    </a>
                }
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="px-2 pb-1">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
    <li class="nav-item ms-2">
        <a class="btn btn-primary btn-lg px-4 fs-6 fw-bold text-white shadow-sm" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
}
</ul>
