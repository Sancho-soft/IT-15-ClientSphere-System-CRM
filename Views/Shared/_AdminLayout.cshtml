<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClientSphere Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/png" href="~/images/logo.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="~/images/logo.png?v=2" />
    <script>
        (function () {
            const saved = localStorage.getItem('clientsphere-theme');
            if (saved === 'dark') document.documentElement.setAttribute('data-bs-theme', 'dark');
        })();
    </script>
    <style>
        body {
            background-color: var(--bs-body-bg);
            color: var(--bs-body-color);
        }
        .sidebar {
            width: 250px;
            height: 100vh;
            background-color: var(--bs-body-bg);
            border-right: 1px solid var(--bs-border-color);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            padding-top: 1rem;
            overflow: hidden;
        }
        .main-content { margin-left: 250px; padding: 2rem; }
        @@media (max-width: 991.98px) { .main-content { padding: 1rem; } }
        .nav-link { color: var(--bs-body-color); font-weight: 500; padding: 0.8rem 1.5rem; display: flex; align-items: center; transition: all 0.2s ease; border-right: 3px solid transparent; }
        .nav-link:hover { color: #0d6efd; background-color: rgba(13, 110, 253, 0.06); border-right-color: rgba(13, 110, 253, 0.4); }
        .nav-link.active { color: #0d6efd; background-color: var(--bs-primary-bg-subtle); border-right-color: #0d6efd; font-weight: 600; }
        .nav-link i { font-size: 1.2rem; margin-right: 0.8rem; }
        
        @@media (max-width: 991.98px) {
            .sidebar { left: -250px; transition: 0.3s; }
            .sidebar.active { left: 0; }
            .main-content { margin-left: 0; }
            .sidebar-overlay { display: none; position: fixed; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 999; top: 0; left: 0; }
            .sidebar-overlay.active { display: block; }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div id="sidebar" class="sidebar d-flex flex-column justify-content-between">
        <div class="d-flex flex-column flex-grow-1 overflow-auto">
            <div class="p-4 text-center mb-2">
                <a href="/" class="d-block">
                    <img src="~/images/logoadmin.png" alt="ClientSphere Admin" style="max-height: 150px; width: auto; max-width: 100%;" class="img-fluid">
                </a>
            </div>
            
            @if (User.IsInRole("Super Admin"))
            {
                <div class="small text-uppercase text-muted fw-bold px-4 mb-2 mt-2" style="font-size: 0.75rem;">CRM Modules</div>
                <nav class="nav flex-column mb-3">
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-file-person"></i> Customers
                    </a>
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-box"></i> Products
                    </a>
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index">
                        <i class="bi bi-graph-up-arrow"></i> Sales
                    </a>
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "Support" ? "active" : "")" asp-controller="Support" asp-action="Index">
                        <i class="bi bi-headset"></i> Support
                    </a>
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "Marketing" ? "active" : "")" asp-controller="Marketing" asp-action="Index">
                        <i class="bi bi-megaphone"></i> Marketing
                    </a>
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "Billing" ? "active" : "")" asp-controller="Billing" asp-action="Index">
                        <i class="bi bi-cash-stack"></i> Billing
                    </a>
                </nav>
            }

            <div class="small text-uppercase text-muted fw-bold px-4 mb-2 mt-4" style="font-size: 0.75rem;">Administration</div>
            <nav class="nav flex-column">
                <a class="nav-link @(ViewData["CurrentPage"] as string == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-grid"></i> Dashboard
                </a>
                @if (User.IsInRole("Super Admin"))
                {
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "User Management" ? "active" : "")" asp-controller="Admin" asp-action="UserManagement">
                        <i class="bi bi-people"></i> User Management
                    </a>
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "Module Management" ? "active" : "")" asp-controller="Admin" asp-action="ModuleManagement">
                        <i class="bi bi-hdd-stack"></i> Module Management
                    </a>
                }
                <a class="nav-link @(ViewData["CurrentPage"] as string == "Analytics" ? "active" : "")" asp-controller="Analytics" asp-action="Index">
                    <i class="bi bi-bar-chart"></i> Analytics
                </a>
                <a class="nav-link @(ViewData["CurrentPage"] as string == "System Settings" ? "active" : "")" asp-controller="Admin" asp-action="SystemSettings">
                    <i class="bi bi-gear"></i> System Settings
                </a>
                @if (User.IsInRole("Super Admin"))
                {
                    <a class="nav-link @(ViewData["CurrentPage"] as string == "ResetPassword" ? "active" : "")" asp-controller="Admin" asp-action="ResetPassword">
                        <i class="bi bi-key"></i> Reset Password
                    </a>
                }
                <a class="nav-link @(ViewData["CurrentPage"] as string == "AuditLog" ? "active" : "")" asp-controller="Admin" asp-action="AuditLog">
                    <i class="bi bi-list-check"></i> Audit Logs
                </a>
            </nav>
        </div>

        </div>
    </div>
    
    <!-- Sidebar Overlay -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Topbar -->
        <header class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom gsap-fade-in">
            @{
                var isDbConnected = true;
                try
                {
                    var dbContext = Context.RequestServices.GetService(typeof(ClientSphere.Data.ApplicationDbContext)) as ClientSphere.Data.ApplicationDbContext;
                    isDbConnected = dbContext?.Database.CanConnect() ?? false;
                }
                catch
                {
                    isDbConnected = false;
                }

                var navUserMgr = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Identity.UserManager<ClientSphere.Models.ApplicationUser>)) as Microsoft.AspNetCore.Identity.UserManager<ClientSphere.Models.ApplicationUser>;
                var navUser = navUserMgr != null ? await navUserMgr.GetUserAsync(User) : null;
                var navFullName = navUser != null && !string.IsNullOrWhiteSpace(navUser.FirstName) ? $"{navUser.FirstName} {navUser.LastName}" : User.Identity?.Name;
                var navFirstName = navUser != null && !string.IsNullOrWhiteSpace(navUser.FirstName) ? navUser.FirstName : User.Identity?.Name;
                var navInitials = navUser != null && !string.IsNullOrWhiteSpace(navUser.FirstName)
                    ? $"{navUser.FirstName[0]}{(string.IsNullOrWhiteSpace(navUser.LastName) ? "" : navUser.LastName[0].ToString())}".ToUpper()
                    : (User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U");
                var navEmail = navUser?.Email ?? User.Identity?.Name;
                var navRoles = navUserMgr != null && navUser != null ? await navUserMgr.GetRolesAsync(navUser) : new List<string>();
                var navRole = navRoles.FirstOrDefault() ?? "Admin";
            }
            <div class="d-flex align-items-center">
                <button id="sidebarToggle" class="btn btn-outline-secondary d-lg-none me-3">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    <h4 class="mb-1 fw-bold">Welcome back, @navFirstName</h4>
                    <div class="text-muted small">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle me-2 px-2 py-1">@navRole</span>
                        <i class="bi bi-calendar3 me-1"></i> <span id="liveDateTime">@DateTime.Now.ToString("dddd, MMMM d, yyyy - hh:mm tt")</span>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge @(isDbConnected ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger") px-3 py-2 rounded-pill">
                    <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> @(isDbConnected ? "System Online" : "System Offline")
                </span>
                <button id="darkModeToggleBtn" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Toggle Dark Mode" onclick="toggleDarkMode()">
                    <i id="darkModeIcon" class="bi bi-moon-stars"></i>
                </button>
                <!-- Notification Bell -->
                <div class="dropdown" id="notifDropdown">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill position-relative px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" id="notifBellBtn">
                        <i class="bi bi-bell"></i>
                        <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;display:none;">0</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1 p-0" style="min-width:320px;max-height:400px;overflow-y:auto;" id="notifList">
                        <li class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <span class="fw-semibold small">Notifications</span>
                            <button class="btn btn-link btn-sm text-muted p-0 text-decoration-none" onclick="markAllRead()" style="font-size:0.78rem;">Mark all read</button>
                        </li>
                        <li id="notifEmpty" class="text-center text-muted py-4 small">No new notifications</li>
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="btn btn-sm d-flex align-items-center gap-2 border rounded-pill px-3 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="max-width: 210px;">
                        @if (navUser != null && !string.IsNullOrEmpty(navUser.ProfilePictureUrl))
                        {
                            <img src="@navUser.ProfilePictureUrl" alt="Profile" class="rounded-circle" style="width: 28px; height: 28px; object-fit: cover; flex-shrink: 0;">
                        }
                        else
                        {
                            <div class="text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.9rem; flex-shrink: 0; background-color: #ff6b35 !important;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                        <div class="text-start overflow-hidden d-none d-md-block">
                            <div class="fw-semibold text-truncate" style="font-size: 0.82rem; line-height: 1.2;">@navFullName</div>
                            <div class="text-muted text-truncate" style="font-size: 0.72rem;">@navRole</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1" style="min-width: 200px;">
                        <li>
                            <div class="px-3 py-2 border-bottom">
                                <div class="fw-bold" style="font-size: 0.88rem;">@navFullName</div>
                                <div class="text-muted" style="font-size: 0.78rem;">@navEmail</div>
                            </div>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person-circle text-primary"></i> Profile Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="px-2 pb-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main role="main" class="gsap-slide-up">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" integrity="sha512-7eHRwcbYkK4d9g/6tD/mhkf++eoTHwpNM9woBxtPUBWm67zeAfFC+HrdoE2GanKeocly/VxeLvIqwvCdk7qScg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" integrity="sha512-onMTRKJBKz8M1TnqqDuGBlowlH0ohFzMXYRNebz+yOcc5Tq/l4503043K4bOowXhDgwH5mGqZk1zEte6xHqYww==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/confirm.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(document).ready(function () {
            $('#sidebarToggle, #sidebarOverlay').on('click', function () {
                $('#sidebar').toggleClass('active');
                $('#sidebarOverlay').toggleClass('active');
            });
        });

        function toggleDarkMode() {
            const html = document.documentElement;
            const isDark = html.getAttribute('data-bs-theme') === 'dark';
            const newTheme = isDark ? 'light' : 'dark';
            html.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('clientsphere-theme', newTheme);
            updateDarkModeIcon(newTheme === 'dark');
        }

        function updateDarkModeIcon(isDark) {
            const icon = document.getElementById('darkModeIcon');
            if (icon) icon.className = isDark ? 'bi bi-sun-fill' : 'bi bi-moon-stars';
        }

        function updateDateTime() {
            const el = document.getElementById('liveDateTime');
            if (el) {
                const now = new Date();
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
                el.innerText = now.toLocaleDateString('en-US', options).replace(' at ', ' - ');
            }
        }
        setInterval(updateDateTime, 60000);

        // Set icon, time, and notifications on page load
        document.addEventListener('DOMContentLoaded', function () {
            const saved = localStorage.getItem('clientsphere-theme');
            updateDarkModeIcon(saved === 'dark');
            updateDateTime();
            loadNotifications();
            setInterval(loadNotifications, 60000);
        });

        function loadNotifications() {
            fetch('/Notifications/GetUnread')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('notifBadge');
                    const list = document.getElementById('notifList');
                    const empty = document.getElementById('notifEmpty');
                    if (!badge || !list) return;

                    if (data.count > 0) {
                        badge.textContent = data.count > 9 ? '9+' : data.count;
                        badge.style.display = '';
                    } else {
                        badge.style.display = 'none';
                    }

                    // Remove old items (keep header + empty)
                    const oldItems = list.querySelectorAll('.notif-item');
                    oldItems.forEach(el => el.remove());

                    if (data.items && data.items.length > 0) {
                        if (empty) empty.style.display = 'none';
                        data.items.forEach(n => {
                            const li = document.createElement('li');
                            li.className = 'notif-item border-bottom';
                            li.innerHTML = `<a href="${n.url || '#'}" class="dropdown-item py-2 text-wrap" onclick="markRead(${n.id}, this)">
                                <div class="fw-semibold small">${n.title}</div>
                                <div class="small text-muted">${n.message}</div>
                                <div class="text-muted" style="font-size:0.72rem;">${n.timeAgo}</div>
                            </a>`;
                            list.appendChild(li);
                        });
                    } else {
                        if (empty) empty.style.display = '';
                    }
                })
                .catch(() => {});
        }

        function markRead(id, el) {
            fetch(`/Notifications/MarkRead/${id}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' } })
                .then(() => loadNotifications());
        }

        function markAllRead() {
            fetch('/Notifications/MarkAllRead', { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' } })
                .then(() => loadNotifications());
        }
    </script>
</body>
</html>

