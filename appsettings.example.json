{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_SERVER;Database=YOUR_DB_NAME;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SendGrid": {
    "ApiKey": "YOUR_SENDGRID_API_KEY",
    "SenderEmail": "your_sender@example.com",
    "SenderName": "ClientSphere"
  },
  "MicrosoftGraph": {
    "ClientId": "YOUR_MICROSOFT_APP_CLIENT_ID",
    "ClientSecret": "YOUR_MICROSOFT_APP_CLIENT_SECRET",
    "TenantId": "common",
    "RedirectUri": "https://YOUR_DOMAIN/SalesStaff/OAuthCallback"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "Paymongo": {
    "PublicKey": "pk_test_YOUR_PAYMONGO_PUBLIC_KEY",
    "SecretKey": "sk_test_YOUR_PAYMONGO_SECRET_KEY",
    "WebhookSecret": "whsk_YOUR_PAYMONGO_WEBHOOK_SECRET",
    "SuccessUrl": "https://YOUR_DOMAIN/CustomerPortal/PaymentSuccess",
    "CancelUrl": "https://YOUR_DOMAIN/CustomerPortal/PaymentCancelled"
  },
  "AllowedHosts": "*"
}
